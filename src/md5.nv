// src/postgres/md5.nv — MD5 password response for the legacy PostgreSQL
// MD5 authentication (AuthenticationMD5Password, code 5). The result is the
// string to place in a PasswordMessage:
//
//   "md5" + hex(md5(hex(md5(password + username)) + salt))
//
// MD5 here is what the PostgreSQL server demands for compatibility; the
// modern path is SCRAM-SHA-256 (scram.nv). Reference: PostgreSQL
// documentation, «Frontend/Backend Protocol» → «MD5 Authentication».

module postgres

import std.crypto.md5.{Md5}
import std.runtime.write_buffer.{WriteBuffer}

/// Build the MD5 password response for `user`/`password` and the 4-byte
/// `salt` from AuthenticationMD5Password. Returns the PasswordMessage
/// payload (including the "md5" prefix), ready for [`ClientMessage.password`].
export fn md5_response(user str, password str, salt [4]u8) -> str {
    // inner = hex(md5(password + username))
    mut inner_input = WriteBuffer.new(cap: password.byte_len() + user.byte_len())
    inner_input.write_str(password)
    inner_input.write_str(user)
    ro inner_hex = Md5.hash_str(inner_input.into_bytes())

    // outer = "md5" + hex(md5(inner_hex + salt))
    mut outer_input = WriteBuffer.new(cap: 32 + 4)
    outer_input.write_str(inner_hex)
    outer_input.write_bytes(salt[..])
    ro outer_hex = Md5.hash_str(outer_input.into_bytes())
    "md5${outer_hex}"
}
