// src/postgres/md5_test.nv — the MD5 authentication vector (plan 286 §Д8а
// criterion 5), independently recomputed by the integrator 2026-09-23:
// user "postgres", password "secret", salt 01 02 03 04
//   -> "md5bb41a296aab6baccb36ff243a562abff".

module postgres

test "MD5 response vector: postgres / secret / 01 02 03 04" {
    ro salt [4]u8 = [1, 2, 3, 4]
    assert(md5_response("postgres", "secret", salt) == "md5bb41a296aab6baccb36ff243a562abff")
}

test "MD5 response changes with the salt" {
    ro salt [4]u8 = [4, 3, 2, 1]
    ro r = md5_response("postgres", "secret", salt)
    assert(r != "md5bb41a296aab6baccb36ff243a562abff")
    assert(r.starts_with("md5"))
    assert(r.byte_len() == 35)
}

test "MD5 response is a valid PasswordMessage payload" {
    // The full PasswordMessage frame for the reference response, per
    // «Message Formats» → «PasswordMessage»: tag 'p', cstring payload.
    ro salt [4]u8 = [1, 2, 3, 4]
    ro response = md5_response("postgres", "secret", salt)
    ro frame = ClientMessage.password(response)
    ro expected = x"70 00 00 00 28 6D 64 35 62 62 34 31 61 32 39 36 61 61 62 36 62 61 63 63 62 33 36 66 66 32 34 33 61 35 36 32 61 62 66 66 00"
    assert(frame == expected)
}
