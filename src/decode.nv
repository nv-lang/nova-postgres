// src/postgres/decode.nv — server message decoder: bytes -> message,
// incremental. The core sans-I/O property: given ANY byte buffer,
// `ServerMessage.decode` either returns a complete message plus the number of
// bytes it consumed, or reports that more bytes are needed. It never panics
// and never blocks; the caller pumps bytes from the socket.
//
// Layout per the PostgreSQL documentation, «Frontend/Backend Protocol» →
// «Message Formats»: one-byte tag, big-endian int32 length (covers itself and
// the payload), payload.
//
// Reference: https://www.postgresql.org/docs/current/protocol-message-formats.html

module postgres

import std.runtime.read_buffer.{ReadBuffer}

// Protocol maximum for a single message length field (1 GiB).
const MAX_MESSAGE_LEN = 1 << 30

// ──────────────────────────────────────────────────────────────────────────
// Decoded message types
// ──────────────────────────────────────────────────────────────────────────

/// One field of a [`ServerMessage.RowDescription`]. All numeric fields are
/// the raw protocol values: `type_oid`/`type_size`/`type_modifier` describe
/// the column type, `format` is 0 (text) or 1 (binary).
export type RowField value {
    ro name str
    ro table_oid int
    ro column int
    ro type_oid int
    ro type_size int
    ro type_modifier int
    ro format int
}

/// One field of an ErrorResponse/NoticeResponse. `code` is the protocol
/// field-code byte (`S` severity, `C` SQLSTATE code, `M` message, ...).
export type ErrorField value {
    ro code u8
    ro value str
}

/// Every server (backend) message of the slice, decoded. Authentication
/// carries the full family the slice authenticates with: Ok, Cleartext,
/// MD5, SASL, SASLContinue, SASLFinal.
export type ServerMessage enum
    | AuthenticationOk
    | AuthenticationCleartextPassword
    | AuthenticationMd5Password { salt [4]u8 }
    | AuthenticationSasl { mechanisms []str }
    | AuthenticationSaslContinue { data []u8 }
    | AuthenticationSaslFinal { data []u8 }
    | ParameterStatus { name str, value str }
    | BackendKeyData { process_id int, secret_key int }
    | ReadyForQuery { status u8 }
    | RowDescription { fields []RowField }
    | DataRow { values []ParamValue }
    | CommandComplete { tag str }
    | ErrorResponse { fields []ErrorField }
    | NoticeResponse { fields []ErrorField }
    /// NotificationResponse ('A'): an asynchronous LISTEN/NOTIFY message.
    /// May arrive at any point of the stream, even between the messages of
    /// an in-flight query answer.
    | NotificationResponse { process_id int, channel str, payload str }
    | ParseComplete
    | BindComplete
    | NoData
    | EmptyQueryResponse

/// Result of one incremental decode attempt over the head of a buffer.
export type DecodeOutcome enum
    /// Fewer bytes than the frame header (or the declared length) are
    /// buffered; feed more and call again.
    | NeedMoreBytes
    /// One complete message; `consumed` is how many buffer bytes it took
    /// (tag + length + payload), so the caller can slice the tail.
    | Message { msg ServerMessage, consumed int }

// ──────────────────────────────────────────────────────────────────────────
// Incremental decode
// ──────────────────────────────────────────────────────────────────────────

/// Decode the message at the head of `bytes`. Pure and total: a buffer too
/// short for a complete frame yields `Ok(NeedMoreBytes)`, a structurally bad
/// frame yields `Err(PostgresError)` — never a panic.
export fn ServerMessage.decode(bytes []u8) -> Result[DecodeOutcome, PostgresError] {
    if bytes.len() < 5 { return Ok(NeedMoreBytes) }
    // One cursor for the whole frame — header and payload read from the
    // same ReadBuffer. `end` is the frame's absolute end offset (1 + len);
    // the payload readers must land exactly on it (finish checks), which
    // keeps them from over-reading into a following frame.
    mut cur = ReadBuffer.from(bytes)
    ro tag = match cur.read_u8() {
        Ok(v) => v
        Err(_) => return Ok(NeedMoreBytes)
    }
    ro len = match cur.read_u32_be() {
        Ok(v) => v as int
        Err(_) => return Ok(NeedMoreBytes)
    }
    if len < 4 { return Err(PostgresError { kind: BadLength { len } }) }
    if len > MAX_MESSAGE_LEN { return Err(PostgresError { kind: LengthOverflow { len } }) }
    if bytes.len() < 1 + len { return Ok(NeedMoreBytes) }
    ro end = 1 + len
    ro msg = decode_payload(tag, cur, end)?
    Ok(Message { msg, consumed: end })
}

/// Decode every complete message in `bytes`, stopping quietly at a trailing
/// incomplete frame (the caller keeps those bytes for the next read).
export fn ServerMessage.decode_all(bytes []u8) -> Result[[]ServerMessage, PostgresError] {
    mut msgs []ServerMessage = []ServerMessage.new()
    mut pos = 0
    while pos < bytes.len() {
        match ServerMessage.decode(bytes[pos..])? {
            NeedMoreBytes => break
            Message { msg, consumed } => {
                msgs.push(msg)
                pos += consumed
            }
        }
    }
    Ok(msgs)
}

// ──────────────────────────────────────────────────────────────────────────
// Payload dispatch — one arm per documented message layout
// ──────────────────────────────────────────────────────────────────────────

fn decode_payload(tag u8, mut cur ReadBuffer, end int) -> Result[ServerMessage, PostgresError] {
    if tag == 'R' as u8 { return decode_auth(cur, end) }
    if tag == 'S' as u8 { return decode_parameter_status(cur, end) }
    if tag == 'K' as u8 { return decode_backend_key_data(cur, end) }
    if tag == 'Z' as u8 {
        ro status = need_u8(cur, "ReadyForQuery status")?
        return Ok(ReadyForQuery { status })
    }
    if tag == 'T' as u8 { return decode_row_description(cur, end) }
    if tag == 'D' as u8 { return decode_data_row(cur, end) }
    if tag == 'C' as u8 {
        ro cmd_tag = cur.read_cstr("CommandComplete tag")?
        finish(cur, end, "CommandComplete")?
        return Ok(CommandComplete { tag: cmd_tag })
    }
    if tag == 'E' as u8 { return decode_error_fields(cur, end, false) }
    if tag == 'N' as u8 { return decode_error_fields(cur, end, true) }
    if tag == 'A' as u8 { return decode_notification(cur, end) }
    if tag == '1' as u8 {
        finish(cur, end, "ParseComplete")?
        return Ok(ParseComplete)
    }
    if tag == '2' as u8 {
        finish(cur, end, "BindComplete")?
        return Ok(BindComplete)
    }
    if tag == 'n' as u8 {
        finish(cur, end, "NoData")?
        return Ok(NoData)
    }
    if tag == 'I' as u8 {
        finish(cur, end, "EmptyQueryResponse")?
        return Ok(EmptyQueryResponse)
    }
    Err(PostgresError { kind: UnknownTag { tag } })
}

// Authentication family: int32 code picks the variant.
fn decode_auth(mut cur ReadBuffer, end int) -> Result[ServerMessage, PostgresError] {
    ro code = need_u32(cur, "authentication code")?
    if code == 0 {
        finish(cur, end, "AuthenticationOk")?
        return Ok(AuthenticationOk)
    }
    if code == 3 {
        finish(cur, end, "AuthenticationCleartextPassword")?
        return Ok(AuthenticationCleartextPassword)
    }
    if code == 5 {
        ro salt = need_bytes(cur, 4, "MD5 salt")?
        finish(cur, end, "AuthenticationMd5Password")?
        ro arr [4]u8 = [salt[0], salt[1], salt[2], salt[3]]
        return Ok(AuthenticationMd5Password { salt: arr })
    }
    if code == 10 {
        // Mechanism names as cstrings, the list itself terminated by a lone
        // NUL — so the terminator is consumed explicitly, not as an empty name.
        mut mechs []str = []str.new()
        while cur.remaining() > 1 {
            mechs.push(cur.read_cstr("SASL mechanism")?)
        }
        ro terminator = need_u8(cur, "SASL mechanism list terminator")?
        if terminator != 0 {
            return Err(PostgresError { kind: Malformed { what: "SASL mechanism list terminator" } })
        }
        return Ok(AuthenticationSasl { mechanisms: mechs })
    }
    if code == 11 {
        ro data = need_rest(cur, end, "SASLContinue data")?
        return Ok(AuthenticationSaslContinue { data })
    }
    if code == 12 {
        ro data = need_rest(cur, end, "SASLFinal data")?
        return Ok(AuthenticationSaslFinal { data })
    }
    Err(PostgresError { kind: Auth { what: "unsupported authentication request code ${code}" } })
}

fn decode_parameter_status(mut cur ReadBuffer, end int) -> Result[ServerMessage, PostgresError] {
    ro name = cur.read_cstr("ParameterStatus name")?
    ro value = cur.read_cstr("ParameterStatus value")?
    finish(cur, end, "ParameterStatus")?
    Ok(ParameterStatus { name, value })
}

fn decode_backend_key_data(mut cur ReadBuffer, end int) -> Result[ServerMessage, PostgresError] {
    ro pid = need_u32(cur, "BackendKeyData process id")?
    ro key = need_u32(cur, "BackendKeyData secret key")?
    Ok(BackendKeyData { process_id: pid, secret_key: key })
}

// NotificationResponse ('A'): int32 pid of the notifying backend, then the
// channel and the payload as cstrings.
fn decode_notification(mut cur ReadBuffer, end int) -> Result[ServerMessage, PostgresError] {
    ro pid = need_u32(cur, "NotificationResponse process id")?
    ro channel = cur.read_cstr("NotificationResponse channel")?
    ro payload = cur.read_cstr("NotificationResponse payload")?
    finish(cur, end, "NotificationResponse")?
    Ok(NotificationResponse { process_id: pid, channel, payload })
}

fn decode_row_description(mut cur ReadBuffer, end int) -> Result[ServerMessage, PostgresError] {
    ro count = need_u16(cur, "RowDescription field count")?
    mut fields []RowField = []RowField.new(cap: count)
    for _ in 0..count {
        ro name = cur.read_cstr("RowDescription field name")?
        ro table_oid = need_u32(cur, "RowDescription table oid")?
        ro column = need_u16(cur, "RowDescription column")?
        ro type_oid = need_u32(cur, "RowDescription type oid")?
        ro type_size = need_u16(cur, "RowDescription type size")?
        ro type_modifier = need_i32(cur, "RowDescription type modifier")?
        ro format = need_u16(cur, "RowDescription format")?
        fields.push(RowField {
            name,
            table_oid,
            column,
            type_oid,
            type_size,
            type_modifier,
            format,
        })
    }
    finish(cur, end, "RowDescription")?
    Ok(RowDescription { fields })
}

fn decode_data_row(mut cur ReadBuffer, end int) -> Result[ServerMessage, PostgresError] {
    ro count = need_u16(cur, "DataRow column count")?
    mut values []ParamValue = []ParamValue.new(cap: count)
    for _ in 0..count {
        ro len = need_i32(cur, "DataRow value length")?
        if len == -1 {
            values.push(ParamValue.null())
        } else if len < 0 {
            return Err(PostgresError { kind: Malformed { what: "DataRow value length below -1" } })
        } else {
            ro bytes = need_bytes(cur, len, "DataRow value")?
            values.push(ParamValue.binary(bytes))
        }
    }
    finish(cur, end, "DataRow")?
    Ok(DataRow { values })
}

// ErrorResponse ('E') and NoticeResponse ('N') share the field layout:
// repeated (code byte, cstring value) pairs, terminated by a zero code byte.
fn decode_error_fields(mut cur ReadBuffer, end int, notice bool) -> Result[ServerMessage, PostgresError] {
    mut fields []ErrorField = []ErrorField.new()
    while true {
        ro code = need_u8(cur, "error/notice field code")?
        if code == 0 { break }
        ro value = cur.read_cstr("error/notice field value")?
        fields.push(ErrorField { code, value })
    }
    finish(cur, end, "ErrorResponse/NoticeResponse")?
    if notice {
        Ok(NoticeResponse { fields })
    } else {
        Ok(ErrorResponse { fields })
    }
}

// ──────────────────────────────────────────────────────────────────────────
// ReadBuffer reads that fail as structured errors, never panics
// ──────────────────────────────────────────────────────────────────────────

fn need_u8(mut cur ReadBuffer, what str) -> Result[u8, PostgresError] {
    match cur.read_u8() {
        Ok(v) => Ok(v)
        Err(_) => Err(PostgresError { kind: Truncated { what } })
    }
}

fn need_u16(mut cur ReadBuffer, what str) -> Result[int, PostgresError] {
    match cur.read_u16_be() {
        Ok(v) => Ok(v as int)
        Err(_) => Err(PostgresError { kind: Truncated { what } })
    }
}

fn need_u32(mut cur ReadBuffer, what str) -> Result[int, PostgresError] {
    match cur.read_u32_be() {
        Ok(v) => Ok(v as int)
        Err(_) => Err(PostgresError { kind: Truncated { what } })
    }
}

fn need_i32(mut cur ReadBuffer, what str) -> Result[int, PostgresError] {
    match cur.read_i32_be() {
        Ok(v) => Ok(v as int)
        Err(_) => Err(PostgresError { kind: Truncated { what } })
    }
}

// NUL-terminated string (protocol cstring). std ReadBuffer has no cstring
// read; this scans the backing buffer for the terminator and converts the
// slice in place — one copy (to_str) instead of growing an accumulator.
// Unterminated or non-UTF-8 input is a Truncated error, matching the rest
// of the need_* family.
fn ReadBuffer mut @read_cstr(what str) -> Result[str, PostgresError] {
    ro start = @position()
    mut i = start
    while i < @data.len() {
        if @data[i] == 0 {
            ro s = match @data[start..i].to_str() {
                Ok(t) => t
                Err(_) => return Err(PostgresError { kind: Truncated { what } })
            }
            @pos = i + 1
            return Ok(s)
        }
        i += 1
    }
    Err(PostgresError { kind: Truncated { what } })
}

fn need_bytes(mut cur ReadBuffer, n int, what str) -> Result[[]u8, PostgresError] {
    match cur.read_bytes(n) {
        Ok(b) => Ok(b)
        Err(_) => Err(PostgresError { kind: Truncated { what } })
    }
}

fn need_rest(mut cur ReadBuffer, end int, what str) -> Result[[]u8, PostgresError] {
    need_bytes(cur, end - cur.position(), what)
}

// Payload must end exactly at the frame end `end` (the absolute offset
// 1 + len). Reading PAST it means the layout outran the declared length
// (Truncated — the slice-bounded cursor used to fail the read); landing
// BEFORE it means bytes the documented layout does not consume (Malformed).
fn finish(cur ReadBuffer, end int, what str) -> Result[(), PostgresError] {
    if cur.position() > end {
        Err(PostgresError { kind: Truncated { what } })
    } else if cur.position() < end {
        Err(PostgresError { kind: Malformed { what } })
    } else {
        Ok(())
    }
}
