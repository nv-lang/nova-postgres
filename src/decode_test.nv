test "NoData matches the documented bytes" {
    // Reference: «Message Formats» → «NoData» — tag 'n', length 4.
    ro reference = x"6E 00 00 00 04"
    assert_prefixes_need_more(reference)
    match assert_decodes(reference) {
        NoData => ()
        _ => assert(false, "wrong variant")
