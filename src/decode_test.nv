test "EmptyQueryResponse matches the documented bytes" {
    // Reference: «Message Formats» → «EmptyQueryResponse» — tag 'I', length 4.
    ro reference = x"49 00 00 00 04"
    assert_prefixes_need_more(reference)
    match assert_decodes(reference) {
        EmptyQueryResponse => ()
        _ => assert(false, "wrong variant")
    }
}

test "unknown tag is a structural error" {
    // 'w' is not a backend message tag; decoding must fail structurally,
    // not panic and not ask for more bytes.
    ro frame = x"77 00 00 00 04"
    match ServerMessage.decode(frame) {
        Err(e) => match e.kind {
            UnknownTag { tag } => assert(tag == 'w' as u8)
            LengthOverflow { len } => assert(false, "wrong kind")
            BadLength { len } => assert(false, "wrong kind")
            Truncated { what } => assert(false, "wrong kind")
            Malformed { what } => assert(false, "wrong kind")
            Auth { what } => assert(false, "wrong kind")
            BadServerSignature => assert(false, "wrong kind")
            Utf8 { what } => assert(false, "wrong kind")
        }
        Ok(NeedMoreBytes) => assert(false, "unknown tag answered NeedMoreBytes")
        Ok(Message { msg, consumed }) => assert(false, "unknown tag decoded as a message")
    }
}

test "length below 4 is a structural error" {
    ro frame = x"5A 00 00 00 03"
    match ServerMessage.decode(frame) {
        Err(e) => match e.kind {
            BadLength { len } => assert(len == 3)
            UnknownTag { tag } => assert(false, "wrong kind")
            LengthOverflow { len } => assert(false, "wrong kind")
            Truncated { what } => assert(false, "wrong kind")
            Malformed { what } => assert(false, "wrong kind")
            Auth { what } => assert(false, "wrong kind")
            BadServerSignature => assert(false, "wrong kind")
            Utf8 { what } => assert(false, "wrong kind")
        }
        Ok(_) => assert(false, "bad length decoded")
    }
}

test "length above the 1 GiB protocol maximum is a structural error" {
    ro frame = x"5A 40 00 00 01"
    match ServerMessage.decode(frame) {
        Err(e) => match e.kind {
            LengthOverflow { len } => assert(len > MAX_MESSAGE_LEN)
            UnknownTag { tag } => assert(false, "wrong kind")
            BadLength { len } => assert(false, "wrong kind")
            Truncated { what } => assert(false, "wrong kind")
            Malformed { what } => assert(false, "wrong kind")
            Auth { what } => assert(false, "wrong kind")
            BadServerSignature => assert(false, "wrong kind")
            Utf8 { what } => assert(false, "wrong kind")
        }
        Ok(_) => assert(false, "oversized length decoded")
    }
}

test "truncated DataRow payload is a structural error" {
    // Declared length covers the count but not the value length that follows.
    ro frame = x"44 00 00 00 06 00 01"
    match ServerMessage.decode(frame) {
        Err(e) => match e.kind {
            Truncated { what } => assert(what == "DataRow value length")
            UnknownTag { tag } => assert(false, "wrong kind")
            LengthOverflow { len } => assert(false, "wrong kind")
            BadLength { len } => assert(false, "wrong kind")
            Malformed { what } => assert(false, "wrong kind")
            Auth { what } => assert(false, "wrong kind")
            BadServerSignature => assert(false, "wrong kind")
            Utf8 { what } => assert(false, "wrong kind")
        }
        Ok(_) => assert(false, "truncated payload decoded")
    }
}

test "unterminated cstring is a structural error" {
    ro frame = x"43 00 00 00 05 41"
    match ServerMessage.decode(frame) {
        Err(e) => match e.kind {
            Truncated { what } => assert(what == "CommandComplete tag")
            UnknownTag { tag } => assert(false, "wrong kind")
            LengthOverflow { len } => assert(false, "wrong kind")
            BadLength { len } => assert(false, "wrong kind")
            Malformed { what } => assert(false, "wrong kind")
            Auth { what } => assert(false, "wrong kind")
            BadServerSignature => assert(false, "wrong kind")
            Utf8 { what } => assert(false, "wrong kind")
        }
        Ok(_) => assert(false, "unterminated cstring decoded")
    }
}

test "trailing bytes past the documented layout are a structural error" {
    // AuthenticationOk with a trailing byte: length 9 instead of 8.
    ro frame = x"52 00 00 00 09 00 00 00 00 FF"
    match ServerMessage.decode(frame) {
        Err(e) => match e.kind {
            Malformed { what } => assert(what == "AuthenticationOk")
            UnknownTag { tag } => assert(false, "wrong kind")
            LengthOverflow { len } => assert(false, "wrong kind")
            BadLength { len } => assert(false, "wrong kind")
            Truncated { what } => assert(false, "wrong kind")
            Auth { what } => assert(false, "wrong kind")
            BadServerSignature => assert(false, "wrong kind")
            Utf8 { what } => assert(false, "wrong kind")
        }
        Ok(_) => assert(false, "frame with trailing bytes decoded")
    }
}
