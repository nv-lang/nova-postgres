// src/postgres/session_query_test.nv — §Д8б criterion 2: the query dialogs
// (two statements, empty, error recovery, extended, notice, parameter
// status), each also fed cut at every point.
// Shared note for the session_*_test.nv peers: the merged per-test binary
// of this package miscompiles several constructs that are fine in a normal
// build — match arms whose variant name exists on two enums vanish silently,
// big records scramble when returned from helpers, vec-of-record indexing
// reads wrong fields. These tests therefore use only []u8-in-local helpers
// and str-returning transcripts; no records or enums cross function
// boundaries. See repro-local/*.nv and the hand-over for the filed repros.

module postgres

// empty query
test "criterion 2: empty query" {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro e1 = match s.feed(cat(auth_ok(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "entry errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(e1.len() == 2, "empty query: entry events")
    match s.query("   ") {
        Ok(()) => ()
        Err(e) => assert(false, "query errored: ${e}")
    }
    ro evs = match s.feed(cat(empty_query(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "empty query errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(evs.len() == 2, "empty query: event count")
    assert(ev(evs[0]) == "empty", "empty query ev0")
    assert(ev(evs[1]) == "ready:I", "empty query ev1")
    assert(s.drain() == cat(startup_ref(), frame('Q' as u8, cstr("   "))), "empty query: client bytes")
    s.close()
}

