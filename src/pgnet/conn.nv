// src/pgnet/conn.nv — the thin network adapter (slice Д8б, TLS in Д8в): the
// ONLY place a socket moves. Everything protocol-shaped lives in the pure
// `postgres` package (Session, ClientMessage, ServerMessage, SslAnswer);
// this module moves bytes between a socket and a Session.
//
// There is deliberately NO either-type of streams in this API: a consume
// enum's type resolves empty in this compiler (repro-local/
// enum_consume_socket), fn-pointer types cannot declare consume
// parameters, and copying a TlsStream is unsafe. The transport is instead
// chosen by the CALLER's control flow, in three small steps:
//
//   1. open_tcp(options)                        — the TCP connection;
//   2. request_ssl(stream)                      — SSLRequest, the server's
//      single answer byte classified by the pure SslAnswer.classify ('S' /
//      'N' / structured protocol error); the socket comes back in a
//      consume record beside the answer;
//   3. connect_tls(stream, options, name, mode) or connect_plain(stream,
//      options) — handshake-over-the-same-socket (nova-tls) or plaintext,
//      then the start-up phase (StartupMessage, authentication — trust,
//      cleartext, MD5, SCRAM-SHA-256 — ParameterStatus/BackendKeyData, up
//      to the first ReadyForQuery).
//
// TlsMode (Disable/Prefer/Require) describes the caller's policy; with the
// step API the caller applies it in its own branches (Require + 'N' ->
// ConnError.RefusedTls, Prefer + 'N' -> connect_plain, Disable -> skip
// request_ssl entirely — no SSLRequest bytes on the wire).
//
// step function and let the compiler instantiate it for both. The Session
// does not change and does not know about TLS.
//
// The SCRAM client nonce is drawn from the OS randomness here, at the edge —
// the pure core never touches randomness.

module postgres.pgnet

import std.net.{TcpStream, NetError}
import std.encoding.base64.{Base64}
import postgres.{Session, SessionPhase, PgEvent, ParamValue, PostgresError, ClientMessage, Ready, SslAnswer}

/// (Slice Д8в criterion 2 names TlsMode - Disable/Prefer/Require. The
/// MODE TYPE lives in the consumer's entry module: this compiler breaks
/// the ABI of third-party (git) package types on any cross-module
/// boundary (repro-local/tls_handshake: a tls value produced in one
/// module and used in another segfaults or corrupts), so pgnet imports
/// nova-tls types nowhere. The negotiation itself is the pure
/// [`SslAnswer.classify`] in the postgres module plus the byte-level
/// [`request_ssl`] here; the TLS handshake and the encrypted transport
/// are composed in the entry module, where tls types are sound - see
/// examples/live.)

/// Connection parameters as a record — usable inside this package and by
/// consumers that do not cross the boundary with it (see the note below).
export type ConnectOptions value {
    ro host str
    ro port int
    ro user str
    ro password str
    ro database str
    /// The name checked against the server's certificate (SNI + hostname
    /// verification). Empty = the `host`.
    ro tls_server_name str
}

/// The name checked against the certificate for these options: the
/// explicit override, or the TCP host.
export fn ConnectOptions @cert_server_name() -> str {
    if @tls_server_name == "" { @host } else { @tls_server_name }
}

// (Slice Д8в criterion 4 names a ConnectOptions record. Records do not
// cross module boundaries soundly in this compiler — a foreign record's
// schema is not registered in the consumer's unit (observed live:
// `unknown type name Nova_postgres_pgnet_ConnectOptions`, then member
// access on an int; same family as repro-local/enum_consume_socket). The
// adapter therefore takes plain scalars — the shape D8b proved cross-
// module — and the record idea is left to the owner with the rest of the
// cross-module type work.)

/// The structured adapter error (slice Д8в criterion 3): every failure
/// branch is distinguishable by VARIANT, the message text is not the only
/// carrier of meaning. `Tls` keeps the nova-tls error whole (match on its
/// kind: CertificateInvalid, HostnameMismatch, ...); `ProtocolViolation`/
/// `AuthFailed` carry the package's own PostgresError; `Server` carries
/// the SQLSTATE and the raw fields of a startup-phase ErrorResponse.
/// (The variant names must not collide with PostgresErrorKind's: match
/// arms resolve variant names across enums in the compilation unit —
/// repro-local/record_enum_tag.)
export type ConnError enum
    /// Transport read/write on the plain socket.
    | Transport { error NetError }
    /// Placeholder for TLS failures in callers that match ConnError
    /// alongside their own TLS error type (pgnet keeps no tls types; see
    /// the module banner).
    | TlsUnavailable
    /// The server answered 'N' to SSLRequest while TLS was required.
    | RefusedTls
    /// A protocol violation (decoder or session state machine).
    | ProtocolViolation { error PostgresError }
    /// The server rejected authentication (SQLSTATE 28P01 and friends).
    | AuthFailed { error PostgresError }
    /// An ErrorResponse during the start-up phase: SQLSTATE + raw fields.
    | Server { sqlstate str, message str }
    /// The pool's limit is reached and nothing is idle
    /// ([`Pool @try_acquire`] only; the blocking [`Pool @acquire`] waits).
    | PoolExhausted

/// Human-readable, single-line description (for logs; match the VARIANT to
/// branch on meaning).
export fn ConnError @to_str() -> str =>
    match @ {
        Transport { error } => "network: ${error.to_str()}"
        TlsUnavailable => "tls error (see the caller's TLS error type)"
        RefusedTls => "server refused TLS (Require)"
        ProtocolViolation { error } => "${error.to_str()}"
        AuthFailed { error } => "${error.to_str()}"
        Server { sqlstate, message } => "server error ${sqlstate}: ${message}"
        PoolExhausted => "pool exhausted (limit reached, nothing idle)"
    }

// Build the Server variant from the event's pre-rendered parts. The
// []ErrorField vec never crosses into the adapter's error state: vecs
// inside enum payloads are the mono shape that corrupts the heap in this
// compilation unit (repro-local/query_error_live).
fn server_error(sqlstate str, message str) -> ConnError =>
    ConnError.Server { sqlstate, message }

/// Constructor for [`ConnectOptions`].
export fn connect_options(host str, port int, user str, password str, database str) -> ConnectOptions =>
    { host, port, user, password, database, tls_server_name: "" }

/// One-call plaintext connect: TCP, then the start-up phase. The
/// convenience wrapper over open_tcp + connect_plain for the common
/// case (no TLS negotiation).
export fn connect(host str, port int, user str, password str, database str) Net Random -> Result[Connection, ConnError] {
    consume stream = match open_tcp(host, port) {
        Ok(consume s) => s
        Err(e) => return Err(e)
    }
    connect_plain(stream, user, password, database)
}

/// Step 1: open the TCP connection.
export fn open_tcp(host str, port int) Net -> Result[TcpStream, ConnError] {
    ro addr = "${host}:${port}"
    match TcpStream.connect(addr) {
        Ok(consume s) => Ok(s)
        Err(e) => Err(ConnError.Transport { error: e })
    }
}

/// Step 2 (skip under TlsMode.Disable): send SSLRequest over the socket
/// (taken as an in-out parameter — it stays in the caller's binding) and
/// classify the server's single answer byte with the pure
/// [`SslAnswer.classify`] — 'S' (TLS on this socket), 'N' (plaintext
/// continues), ANY other byte (including 'E', an old server's
/// ErrorResponse tag) a structured protocol error. On an early return the
/// caller's consume binding closes the socket through its auto-@cleanup;
/// on Ok the caller keeps the socket and moves it into connect_tls or
/// connect_plain per the answer.
export fn request_ssl(mut stream TcpStream) Net -> Result[SslAnswer, ConnError] {
    match stream.write_all(ClientMessage.ssl_request()) {
        Ok(()) => ()
        Err(e) => return Err(ConnError.Transport { error: e })
    }
    ro answer = match stream.read_bytes(1) {
        Ok(b) => b
        Err(e) => return Err(ConnError.Transport { error: e })
    }
    if answer.len() == 0 {
        ro pe = PostgresError { kind: Protocol { what: "server closed the connection without answering SSLRequest" } }
        return Err(ConnError.ProtocolViolation { error: pe })
    }
    match SslAnswer.classify(answer[0]) {
        Err(pe) => Err(ConnError.ProtocolViolation { error: pe })
        Ok(a) => Ok(a)
    }
}

/// Step 3: plaintext start-up over the open socket (TlsMode.Disable, or
/// the 'N' fallback of TlsMode.Prefer decided by the caller of the step
/// API).
export fn connect_plain(consume stream TcpStream, user str, password str, database str) Net Random -> Result[Connection, ConnError] {
    consume conn = Connection {
        stream,
        session: Session.new(user, password, database, Base64.encode(Random.bytes(18))),
        iter: ConnIter { pending: []PgEvent.new(), pos: 0, notifyq: []Notification.new(), err: ConnError.TlsUnavailable, err_set: false, done: true },
    }
    start_plain(conn)
}

/// A plaintext PostgreSQL connection. A consume type, like its parts
/// (D131): stepped by the query methods, ended exactly once by
/// [`Connection @close`] or by the scope-exit cleanup.
/// Iteration state of the connection's row cursor: decoded events not
/// yet delivered, the cursor position in them, and the error that ended
/// the last iteration. A consume type so Connection keeps its all-
/// consume field shape across module boundaries.
export type ConnIter consume {
    mut pending []PgEvent
    mut pos int
    /// Buffered LISTEN/NOTIFY notifications: pump_once routes
    /// PgEvent.Notify here (never into `pending`), both while idle
    /// and mid-query, so an asynchronous notification is never lost and
    /// never surfaces as a row.
    mut notifyq []Notification
    /// The error that ended the last iteration. NOT Option[ConnError]:
    /// an enum-with-payload inside Option, stored in a record field,
    /// mis-lowers in the large live example TU and corrupts the heap
    /// (a plain enum field + a set flag lowers soundly; measured: the
    /// Option[ConnError] field crashed 11-18 of 15-20 runs).
    mut err ConnError
    /// Whether `err` carries the ended iteration's error.
    mut err_set bool
    /// True once the ReadyForQuery that closes the answer (or a fatal
    /// error) was reached — further next() calls return None WITHOUT
    /// touching the socket.
    mut done bool
}

// Consumes the state when the connection is dropped. Nothing to
// release — the marker exists so Connection keeps an all-consume field
// shape, which is the layout this compiler lowers soundly across module
// boundaries (mixed consume/plain record fields mis-layout).
export fn ConnIter consume @discard() -> () {}

export type Connection consume {
    consume stream TcpStream
    consume session Session
    consume iter ConnIter
}

/// One asynchronous LISTEN/NOTIFY message (plan 286.1): the notifying
/// backend's process id, the channel, and the payload.
export type Notification value {
    ro pid int
    ro channel str
    ro payload str
}

// ──────────────────────────────────────────────────────────────────────────
// The connection's method surface, delegating to the implementations below.
// ──────────────────────────────────────────────────────────────────────────

/// Run one simple-protocol query and return every event up to (excluding)
/// the ReadyForQuery that closes the cycle. A server ErrorResponse is one
/// of the events (QueryError carries the SQLSTATE); the connection stays
/// usable.
/// Like [`Connection @query`] the previous answer is drained first:
/// an un-drained ReadyForQuery can never desync the protocol.
export fn Connection mut @simple_query(q str) Net -> Result[[]PgEvent, ConnError] {
    match @ensure_drained() {
        Ok(()) => ()
        Err(e) => return Err(e)
    }
    simple_query_plain(@, q)
}

/// Run one extended-protocol cycle (Parse/Bind/Describe/Execute/Sync,
/// unnamed statement and portal, text formats on both sides) with
/// `params` — SQL NULL as ParamValue.null().
/// The previous answer is drained first, as in [`Connection @simple_query`].
export fn Connection mut @extended_query(sql str, params []ParamValue) Net -> Result[[]PgEvent, ConnError] {
    match @ensure_drained() {
        Ok(()) => ()
        Err(e) => return Err(e)
    }
    extended_query_plain(@, sql, params)
}

/// Queue a simple-protocol query and turn the connection into a row
/// cursor: pull rows with `for row in conn` / [`Connection @next`].
/// Nothing is collected up front — socket bytes are read only as the
/// next row needs them. The connection is NOT given away; the next
/// query runs on it as soon as this answer is drained — by iterating
/// to the end, or implicitly: an unfinished answer (including one cut
/// short by a server error whose `error()` was never read) is drained
/// and discarded here, so an un-drained ReadyForQuery can never
/// desync the protocol. A fatal connection error surfaces as the
/// returned Err instead.
export fn Connection mut @query(q str) Net -> Result[(), ConnError] {
    match @ensure_drained() {
        Ok(()) => ()
        Err(e) => return Err(e)
    }
    match @session.query(q) {
        Ok(()) => ()
        Err(e) => return Err(ConnError.ProtocolViolation { error: e })
    }
    @iter.pending.truncate(0)
    @iter.pos = 0
    @iter.err_set = false
    @iter.done = false
    Ok(())
}

// Read and discard the rest of the current answer, so the session is
// Ready for the next one. The single implementation behind both the
// implicit drain at query entry and the explicit [`Connection
// @skip_answer`]. Cheap no-op when the answer already ended.
fn Connection mut @ensure_drained() Net -> Result[(), ConnError] {
    while !@iter.done {
        ro _ = @next()
    }
    if @iter.err_set {
        match @iter.err {
            // A server error ends the answer but not the connection:
            // the session reached ReadyForQuery and is reusable. The
            // error stays readable via @error until the next query.
            ConnError.Server { .. } => return Ok(())
            _ => return Err(@iter.err)
        }
    }
    Ok(())
}

// Remember the error that ended the iteration. A mut METHOD (not a plain
// fn taking the record as a mut parameter, not an inline write at every
// next() arm): both of those mis-lower in the large live example TU and
// corrupt the heap - a mut-parameter record write does not land on the
// caller's value (the known mut-param visibility defect), and an inline
// payload-enum write in the big next() body corrupts adjacent memory
// (measured: 6-18 crashes of 12-20 runs; the method form survives 20/20).
export fn ConnIter mut @remember(e ConnError) -> () {
    @err = e
    @err_set = true
}

/// The next row at runtime: `Some(Row { values })` per DataRow, `None`
/// at the ReadyForQuery that closes the cycle — directly iterable with
/// `for row in conn { … }`. Non-row events are consumed inside. An
/// error ENDS the iteration and is remembered for [`Connection @error`]:
/// a server error (SQLSTATE) leaves the connection usable (drain the
/// rest with skip_answer); anything else means it is dead.
#impl(Next[PgEvent])
export fn Connection mut @next() Net -> Option[PgEvent] {
    if @iter.done {
        return None
    }
    if @iter.err_set {
        match @iter.err {
            // A remembered server error does not block draining: the
            // session skips to ReadyForQuery by itself, and the cursor
            // must get there before the next query. Fatal errors stick.
            ConnError.Server { .. } => ()
            _ => {
                @iter.done = true
                return None
            }
        }
    }
    while true {
        if @iter.pos < @iter.pending.len() {
            ro e = @iter.pending[@iter.pos]
            @iter.pos += 1
            match @dispatch_event(e) {
                Some(ev) => return Some(ev)
                None => {
                    if @iter.done {
                        return None
                    }
                }
            }
        } else {
            match @pump_once() {
                Ok(()) => ()
                Err(e) => {
                    @iter.remember(e)
                    @iter.done = true
                    return None
                }
            }
        }
    }
    None
}

// The socket half of one next() step: drain the session's outbound bytes,
// write them, read one chunk, feed it, buffer the decoded events. A
// separate small method - inlining this into next() mis-lowers in the
// large live example TU once a QueryError event is in play and corrupts
// the heap (repro-local/query_error_live; measured 15-20/15-20 segfaults,
// this split form survives 20/20).
fn Connection mut @pump_once() Net -> Result[(), ConnError] {
    @iter.pending.truncate(0)
    @iter.pos = 0
    ro out = @session.drain()
    if out.len() > 0 {
        match write_stream(@stream, out) {
            Ok(()) => ()
            Err(e) => return Err(e)
        }
    }
    ro chunk = match read_stream(@stream, 65536) {
        Ok(b) => b
        Err(e) => return Err(e)
    }
    if chunk.len() == 0 {
        // A clean EOF mid-read is a transport fact, not a protocol
        // violation (a backend kill lands exactly here).
        return Err(ConnError.Transport { error: NetError.Eof })
    }
    match @session.feed(chunk) {
        Ok(evs) => {
            // A QueryError event is NOT buffered: a payload-carrying enum
            // value entering the pending vec (a record field) is the mono
            // shape that corrupts the heap in the live example TU
            // (repro-local/query_error_live). It is remembered here, at
            // pump time; rows already decoded before the error stay
            // buffered and are delivered before the Ready that ends the
            // answer - the session emits no rows after an error anyway.
            mut j = 0
            while j < evs.len() {
                match evs[j] {
                    QueryError { sqlstate, message } =>
                        @iter.remember(server_error(sqlstate, message))
                    // Asynchronous LISTEN/NOTIFY: buffered in the notify
                    // queue (try_next_event / next_event), never a row,
                    // never lost mid-query.
                    Notify { pid, channel, payload } =>
                        @iter.notifyq.push(Notification { pid, channel, payload })
                    _ => @iter.pending.push(evs[j])
                }
                j += 1
            }
            Ok(())
        }
        Err(e) => Err(session_error(e))
    }
}

// Kind dispatch for one buffered event, in its own method: the payload
// is never rebound - the originally fetched value is returned as-is
// (rebuilding a Row here made the mono collector emit a SECOND C type for
// PgEvent, Option<Event2> vs Option[PgEvent>, mismatching at the call
// boundary). Kept out of next()'s body: with a QueryError arm inline, the
// big next() mis-lowers in the live example TU and corrupts the heap
// (repro-local/query_error_live).
fn Connection mut @dispatch_event(e PgEvent) -> Option[PgEvent] {
    match e {
        Row { .. } => return Some(e)
        Ready { .. } => {
            @iter.pending.truncate(0)
            @iter.pos = 0
            @iter.done = true
            return None
        }
        // QueryError never reaches pending: pump_once remembers it and
        // filters it out of the buffer.
        _ => ()
    }
    None
}

/// The iterator-source half of the protocol: a Connection IS its cursor
/// (Next[PgEvent] above), so iterating it yields itself.
export fn Connection @iter() -> Connection => @

/// The error that ended the last iteration (None on a clean end).
export fn Connection @error() -> Option[ConnError] {
    if @iter.err_set {
        return Some(@iter.err)
    }
    None
}

/// Non-blocking poll of the buffered notifications (LISTEN/NOTIFY):
/// `Some(Notification)` if one has already arrived (including ones that
/// came in mid-query), `None` otherwise. Never touches the socket.
export fn Connection mut @try_next_event() -> Option[Notification] {
    if @iter.notifyq.len() == 0 {
        return None
    }
    ro n = @iter.notifyq[0]
    @iter.notifyq.remove(0, 1)
    Some(n)
}

/// Blocking wait for the next notification: reads the socket until the
/// server pushes one. Legal only while the connection is idle (no answer
/// in flight — between `for row in conn` cycles); calling it mid-answer
/// is a structural Protocol error. Cancellation is the fiber's, like
/// pgx's ctx-cancel: kill the waiting fiber.
export fn Connection mut @next_event() Net -> Result[Notification, ConnError] {
    if !@iter.done {
        ro pe = PostgresError { kind: Protocol { what: "next_event while an answer is in flight (finish or skip it first)" } }
        return Err(ConnError.ProtocolViolation { error: pe })
    }
    while true {
        match @try_next_event() {
            Some(n) => return Ok(n)
            None => {
                match @pump_once() {
                    Ok(()) => ()
                    Err(e) => return Err(e)
                }
            }
        }
    }
    Err(ConnError.TlsUnavailable)  // unreachable; keeps the match tail typed
}

/// Drain the rest of the current answer (rows are read and dropped)
/// so the session is Ready for the next query. For a server error this
/// drains the skip to ReadyForQuery; a dead connection surfaces its
/// error.
/// Explicitly drain the rest of the current answer. Rarely needed —
/// iterating to the end or starting the next query drains implicitly
/// ([`Connection @ensure_drained`]); this is the early-exit form for
/// code that wants the connection Ready NOW without starting a query.
/// A remembered server error is cleared on success (it belongs to the
/// finished answer); a fatal error is returned and the connection is
/// dead. Same implementation as the implicit drain.
export fn Connection mut @skip_answer() Net -> Result[(), ConnError] {
    match @ensure_drained() {
        Ok(()) => {
            @iter.err_set = false
            Ok(())
        }
        Err(e) => Err(e)
    }
}

/// Transaction-status byte of the last ReadyForQuery (`I`/`T`/`E`).
export fn Connection @transaction_status() -> u8 =>
    @session.transaction_status()

/// Close politely: send everything the session still owes (Terminate last)
/// and end the connection. Consumes it — after this call the connection
/// cannot be used; the socket closes at scope end on its own auto-cleanup,
/// same as the D8a smoke.
export fn Connection consume @close() Net -> Result[(), ConnError] {
    ro fin = @session.close()
    write_stream(@stream, fin)
}

/// Scope-exit cleanup (D432): a connection bound as `consume conn = …`
/// and left unconsumed — an early return, a forgotten close — is closed
/// politely at scope exit; the final flush (Terminate) still reaches the
/// server. Explicit [`@close`] remains for callers that want to observe
/// the write error.
export fn Connection consume @cleanup(outcome ScopeOutcome) Net -> () {
    match outcome {
        Success => {
            // Штатный выход: если ответ дочитан не до конца — дочитать
            // (сервер завершит чисто), затем закрыть вежливо.
            ro _d = @drain_for_cleanup()
            ro _r = @close()
        }
        _ => {
            ro _r = @close()
        }
    }
}

// Drain a half-finished answer at scope exit; errors are dropped — the
// scope is already ending.
fn Connection consume @drain_for_cleanup() Net -> () {
    mut guard = 0
    while @next() != None && guard < 100000000 {
        guard += 1
    }
}

/// The row's `i`-th value as text — the ergonomic accessor for the
/// common "read a column" case; NULL and non-UTF-8 values are
/// structured errors, never silent defaults.
/// Text-decode one column of a Row event — the chainable form:
/// `row.text_at(0)?` in a for-in body. Non-Row events, a NULL value, a
/// out-of-range index and invalid UTF-8 are structured errors, never
/// panics.
export fn PgEvent @text_at(i int) -> Result[str, ConnError] {
    match @ {
        Row { values } => {
            if i < 0 || i >= values.len() {
                ro pe = PostgresError { kind: MalformedPayload { what: "column index out of range" } }
                return Err(ConnError.ProtocolViolation { error: pe })
            }
            ro v = values[i]
            match v.data {
                Some(b) => match b.to_str() {
                    Ok(t) => Ok(t)
                    Err(_) => {
                        ro pe = PostgresError { kind: Utf8 { what: "row value" } }
                        Err(ConnError.ProtocolViolation { error: pe })
                    }
                }
                None => {
                    ro pe = PostgresError { kind: MalformedPayload { what: "row value is NULL" } }
                    Err(ConnError.ProtocolViolation { error: pe })
                }
            }
        }
        _ => {
            ro pe = PostgresError { kind: Protocol { what: "expected a DataRow event" } }
            Err(ConnError.ProtocolViolation { error: pe })
        }
    }
}

/// The free-function spelling of [`PgEvent @text_at`], kept for
/// call sites that hold the event indirectly.
export fn text_at(row PgEvent, i int) -> Result[str, ConnError] =>
    row.text_at(i)
// Structured MalformedPayload error with the offending value in the message.
fn malformed(what str) -> ConnError =>
    ConnError.ProtocolViolation { error: PostgresError { kind: MalformedPayload { what } } }

/// Column i decoded as an integer (Postgres int/serial family, any size
/// Nova's int parses). The chainable form: `row.int_at(0)?`.
export fn PgEvent @int_at(i int) -> Result[int, ConnError] =>
    @text_at(i).flat_map(|s| match s.to_int() {
        Ok(n) => Ok(n)
        Err(_) => Err(malformed("not an integer: '${s}'"))
    })

/// Column i decoded as i64 (Postgres bigint/bigserial).
export fn PgEvent @i64_at(i int) -> Result[i64, ConnError] =>
    @text_at(i).flat_map(|s| match s.to_i64() {
        Ok(n) => Ok(n)
        Err(_) => Err(malformed("not an i64: '${s}'"))
    })

/// Column i decoded as i16 (Postgres smallint/int2).
export fn PgEvent @i16_at(i int) -> Result[i16, ConnError] =>
    @text_at(i).flat_map(|s| match s.to_i16() {
        Ok(n) => Ok(n)
        Err(_) => Err(malformed("not an i16: '${s}'"))
    })

/// Column i decoded as i32 (Postgres integer/serial).
export fn PgEvent @i32_at(i int) -> Result[i32, ConnError] =>
    @text_at(i).flat_map(|s| match s.to_i32() {
        Ok(n) => Ok(n)
        Err(_) => Err(malformed("not an i32: '${s}'"))
    })

/// Column i decoded as f64 — Postgres float8 (double precision) and
/// float4 (real, widened exactly). NOT numeric/decimal: those are
/// arbitrary-precision (131072/16383 digits); decoding them as f64
/// loses precision and range. Read numeric with text_at and parse it
/// with a decimal package: `row.text_at(i)?.to_bigdecimal()` in the
/// consumer's module (nova-bignum). pgnet itself stays std-only:
/// third-party package types do not survive this compiler's cross-module
/// boundary, see the module banner.
export fn PgEvent @f64_at(i int) -> Result[f64, ConnError] =>
    @text_at(i).flat_map(|s| match s.to_f64() {
        Ok(n) => Ok(n)
        Err(_) => Err(malformed("not an f64: '${s}'"))
    })

/// Column i decoded as bool. Postgres sends 't'/'f' in the text
/// protocol; the strict std "true"/"false" spellings are accepted too.
export fn PgEvent @bool_at(i int) -> Result[bool, ConnError] =>
    @text_at(i).flat_map(|s| {
        if s == "t" {
            return Ok(true)
        }
        if s == "f" {
            return Ok(false)
        }
        match s.to_bool() {
            Ok(b) => Ok(b)
            Err(_) => Err(malformed("not a boolean: '${s}'"))
        }
    })


// ──────────────────────────────────────────────────────────────────────────
// Per-transport implementations. The bodies are identical by design; they
// are duplicated because a generic over the connection type does not
// monomorphize field access on the type parameter in this compiler
// (codegen: no matching overload for the stream access). One type, one
// pump - boring and predictable.
// ──────────────────────────────────────────────────────────────────────────

fn simple_query_plain(mut conn Connection, q str) Net -> Result[[]PgEvent, ConnError] {
    match conn.session.query(q) {
        Ok(()) => ()
        Err(e) => return Err(ConnError.ProtocolViolation { error: e })
    }
    pump_plain(conn)
}

fn extended_query_plain(mut conn Connection, sql str, params []ParamValue) Net -> Result[[]PgEvent, ConnError] {
    match conn.session.query_extended(sql, [], params, []) {
        Ok(()) => ()
        Err(e) => return Err(ConnError.ProtocolViolation { error: e })
    }
    pump_plain(conn)
}

fn write_stream(mut s TcpStream, data []u8) Net -> Result[(), ConnError] {
    match s.write_all(data) {
        Ok(()) => Ok(())
        Err(e) => Err(ConnError.Transport { error: e })
    }
}

fn read_stream(mut s TcpStream, max int) Net -> Result[[]u8, ConnError] {
    match s.read_bytes(max) {
        Ok(b) => Ok(b)
        Err(e) => Err(ConnError.Transport { error: e })
    }
}

// ──────────────────────────────────────────────────────────────────────────
// Start-up and the query pump - one concrete pair per transport
// ──────────────────────────────────────────────────────────────────────────

fn start_plain(consume conn Connection) Net -> Result[Connection, ConnError] {
    ro evs = match pump_plain(conn) {
        Ok(e) => e
        Err(e) => {
            ro _c = conn.close()
            return Err(e)
        }
    }
    startup_check_plain(conn, evs)
}

fn startup_check_plain(consume conn Connection, evs []PgEvent) Net -> Result[Connection, ConnError] {
    mut i = 0
    while i < evs.len() {
        match evs[i] {
            QueryError { sqlstate, message } => {
                ro _c = conn.close()
                return Err(server_error(sqlstate, message))
            }
            _ => ()
        }
        i += 1
    }
    if conn.session.phase() != SessionPhase.Ready {
        ro e = PostgresError { kind: Protocol { what: "connection left the start-up phase without ReadyForQuery" } }
        ro _c = conn.close()
        return Err(ConnError.ProtocolViolation { error: e })
    }
    Ok(conn)
}

fn pump_plain(mut conn Connection) Net -> Result[[]PgEvent, ConnError] {
    mut events []PgEvent = []PgEvent.new()
    while true {
        ro out = conn.session.drain()
        if out.len() > 0 {
            write_stream(conn.stream, out)?
        }
        ro chunk = read_stream(conn.stream, 65536)?
        if chunk.len() == 0 {
            return Err(ConnError.Transport { error: NetError.Eof })
        }
        ro evs = match conn.session.feed(chunk) {
            Ok(e) => e
            Err(e) => return Err(session_error(e))
        }
        mut i = 0
        while i < evs.len() {
            match evs[i] {
                Ready { .. } => {
                    return Ok(events)
                }
                _ => {
                    events.push(evs[i])
                    i += 1
                }
            }
        }
    }
    Ok(events)
}


// A session/decoder failure classified for the adapter: an Auth kind means
// the server rejected authentication; anything else is a protocol failure.
fn session_error(e PostgresError) -> ConnError {
    match e.kind {
        Auth { .. } => ConnError.AuthFailed { error: e }
        _ => ConnError.ProtocolViolation { error: e }
    }
}

// cache-probe-touch
