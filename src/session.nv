// src/postgres/session.nv — Session: the connection as a PURE state machine
// (plan 286 §Д8б). Input: bytes arriving from the server. Output:
// [`PgEvent`]s and bytes to send (drained by the caller). Phases:
//
//   Authenticating → Startup → Ready ⇄ (QuerySimple | QueryExtended) → Closed
//                                                          ↘ Failed
//
// No socket, no clock, no randomness inside: the caller injects the SCRAM
// client nonce at construction (the network adapter draws it from the OS at
// the edge). Authentication covers trust, cleartext, MD5 and SCRAM-SHA-256.
// After an ErrorResponse mid-query the machine skips everything until the
// ReadyForQuery that closes the cycle — that recovery is a slice criterion.
//
// Protocol reference: PostgreSQL documentation, «Frontend/Backend Protocol»
// → «Message Flow» (Start-up, Simple Query, Extended Query) and «Message
// Formats»; RFC 7677 for the SCRAM-SHA-256 profile.

module postgres

/// Phase of a [`Session`], exposed read-only. The lifecycle is
/// `Authenticating → Startup → Ready`, then one `QuerySimple`/`QueryExtended`
/// per query round, ending back in `Ready`; `Closed` is polite shutdown,
/// `Failed` is an unrecoverable protocol/decode error (every further `feed`
/// returns a structured error).
export type SessionPhase enum
    | Authenticating
    | Startup
    | Ready
    | QuerySimple
    | QueryExtended
    | Closed
    | Failed

/// One step of the extended-protocol cycle the session currently expects.
/// `ExtParse` → ParseComplete, `ExtBind` → BindComplete, `ExtDescribe` →
/// RowDescription or NoData, `ExtExecute` → DataRow*/CommandComplete.
export type ExtStage enum
    | ExtParse
    | ExtBind
    | ExtDescribe
    | ExtExecute

/// Everything the application learns from the server, in order. Row values
/// arrive raw — `Some(bytes)` in the column's negotiated format (text unless
/// a binary result format was requested), `None` for SQL NULL. Type codecs
/// are a later slice; this slice does not interpret bytes.
export type PgEvent enum
    /// AuthenticationOk: the authentication exchange succeeded;
    /// ParameterStatus/BackendKey/Ready events follow.
    | Authenticated
    | Parameter { name str, value str }
    /// The backend keys advertised by BackendKeyData; the pair a
    /// CancelRequest frame needs ([`ClientMessage.cancel_request`]).
    | BackendKey { process_id int, secret_key int }
    /// ReadyForQuery; `status` is the transaction-status byte
    /// (`I` idle, `T` in transaction, `E` failed transaction).
    | Ready { status u8 }
    | RowDesc { fields []RowField }
    | Row { values []ParamValue }
    | Complete { tag str }
    /// EmptyQueryResponse: the query string contained only whitespace.
    | EmptyQuery
    /// A NoticeResponse the server interleaved; not fatal.
    | Notice { fields []ErrorField }
    /// An ErrorResponse mid-query. The session skips to the ReadyForQuery
    /// that closes the cycle and recovers; the event carries the SQLSTATE
    /// (field `C`) and the human message (field `M`), rendered at decode.
    /// NOT the raw []ErrorField vec: a vec inside this enum's payload is
    /// the mono shape that corrupts the heap when the event and the
    /// adapter's iterator state share a compilation unit (measured in
    /// repro-local/query_error_live: 15/15 segfaults; the str payload
    /// survives 20/20).
    | QueryError { sqlstate str, message str }
    /// A NotificationResponse the server pushed asynchronously (LISTEN /
    /// NOTIFY). Legal in every phase — between ReadyForQuery's while idle
    /// and interleaved with the messages of an in-flight answer. `pid` is
    /// the notifying backend's process id.
    | Notification { pid int, channel str, payload str }

/// The connection state machine. Pure: feed bytes in, drain bytes out, read
/// events off each [`Session @feed`] call. Fields are private to the
/// exchange — observe through events and the read-only getters.
///
/// A consume type (D131): a session is a single linear state — it is
/// created once, stepped in place through its `mut @` methods, and must be
/// ended explicitly with [`Session @close`]. No copy semantics, no aliasing:
/// a consumer cannot accidentally branch on one session or lose updates in a
/// helper that took it by value.
export type Session consume {
    ro user str
    ro password str
    ro database str
    ro client_nonce str
    mut phase SessionPhase
    mut inbound []u8
    mut outbound []u8
    mut scram Option[ScramClient]
    mut txn_status u8
    mut backend_pid int
    mut backend_key int
    /// Simple/extended: a RowDescription (or Describe answer) was seen and
    /// DataRow is legal now.
    mut expect_rows bool
    /// An ErrorResponse arrived mid-query; everything until the answering
    /// ReadyForQuery is skipped.
    mut in_error bool
    mut ext_stage ExtStage
}

/// New session for `user`/`password`/`database`. The StartupMessage is
/// already queued: drain and send it first. `client_nonce` must be unique
/// per attempt; the consumer draws it (the pure core never touches
/// randomness). It is only used if the server offers SCRAM-SHA-256.
export fn Session.new(user str, password str, database str, client_nonce str) -> Session {
    Session {
        user,
        password,
        database,
        client_nonce,
        phase: Authenticating,
        inbound: []u8.new(),
        outbound: ClientMessage.startup([("user", user), ("database", database)]),
        scram: None,
        txn_status: 'I' as u8,
        backend_pid: 0,
        backend_key: 0,
        expect_rows: false,
        in_error: false,
        ext_stage: ExtExecute,
    }
}

/// Current phase.
export fn Session @phase() -> SessionPhase =>
    @phase

/// Transaction-status byte of the last ReadyForQuery (`I`/`T`/`E`).
export fn Session @transaction_status() -> u8 =>
    @txn_status

/// Bytes queued for the server since the last drain (or since construction).
/// Empties the queue; the result is ready for `write_all`.
export fn Session mut @drain() -> []u8 {
    ro out = @outbound
    @outbound = []u8.new()
    out
}

/// Queue a simple-protocol query. Only legal in `Ready`; the returned
/// error is structural, never a panic.
export fn Session mut @query(q str) -> Result[(), PostgresError] {
    if @phase != Ready {
        return Err(PostgresError { kind: Protocol { what: "simple query issued while the session is not ready" } })
    }
    @outbound.append(ClientMessage.query(q))
    @phase = QuerySimple
    @expect_rows = false
    @in_error = false
    Ok(())
}

/// Queue an extended-protocol cycle: Parse (unnamed statement, no declared
/// parameter types), Bind (unnamed portal, `param_formats`/`result_formats`
/// as format codes, [`ParamValue.null`] = SQL NULL), Describe portal,
/// Execute, Sync. Only legal in `Ready`.
///
/// Parameters are []ParamValue, not []Option[[]u8]: Option[[]u8] mislowers
/// at the C-codegen stage — as a vec element it breaks the build loudly
/// (repro-local/opt_slice_iter), and inside an enum payload it corrupts the
/// enum's vec storage silently (repro-local/enum_opt_slice). Inside the
/// ParamValue record it lowers correctly (unchanged since D8a).
export fn Session mut @query_extended(sql str, param_formats []int, params []ParamValue, result_formats []int) -> Result[(), PostgresError] {
    if @phase != Ready {
        return Err(PostgresError { kind: Protocol { what: "extended query issued while the session is not ready" } })
    }
    @outbound.append(ClientMessage.parse("", sql, []))
    @outbound.append(ClientMessage.bind("", "", param_formats, params, result_formats))
    @outbound.append(ClientMessage.describe('P' as u8, ""))
    @outbound.append(ClientMessage.execute("", 0))
    @outbound.append(ClientMessage.sync())
    @phase = QueryExtended
    @ext_stage = ExtParse
    @expect_rows = false
    @in_error = false
    Ok(())
}

/// Close the session: queue Terminate (unless it has Failed), move to
/// `Closed`, and return every byte still queued — the final flush for the
/// connection, in one piece. Consumes the session: the mandatory final
/// step, enforced by the type system (D133) — a session cannot be dropped
/// or accidentally reused after closing.
export fn Session consume @close() -> []u8 {
    if @phase != Failed {
        @outbound.append(ClientMessage.terminate())
        @phase = Closed
    }
    ro out = @outbound
    @outbound = []u8.new()
    out
}

/// Feed bytes arriving from the server. Decodes every complete message in
/// the buffer, applies it to the state machine, and returns the events the
/// application should see. A trailing incomplete frame stays buffered for
/// the next call — the exchange survives any chunking. Structural failures
/// (a bad frame, an illegal transition) move the session to `Failed` and
/// return `Err`; the session is then unusable.
export fn Session mut @feed(bytes []u8) -> Result[[]PgEvent, PostgresError] {
    if @phase == Closed || @phase == Failed {
        return Err(PostgresError { kind: Protocol { what: "feed on a closed or failed session" } })
    }
    @inbound.append(bytes)
    mut events []PgEvent = []PgEvent.new()
    // Walk by offset, compacting the buffer once at the end: no allocation
    // happens in the loop besides the decoder's own, so nothing can move
    // under the decoded message between decode and dispatch (an allocation
    // there reads as a dangling tag — observed in the wild as DataRow
    // dispatching as AuthenticationSaslFinal; see repro-local/session_feed).
    mut pos = 0
    while pos < @inbound.len() {
        match ServerMessage.decode(@inbound[pos..]) {
            Ok(NeedMoreBytes) => break
            Err(e) => {
                @phase = Failed
                return Err(e)
            }
            Ok(Message { msg, consumed }) => {
                pos += consumed
                match @dispatch(msg, events) {
                    Ok(()) => {
                        if @phase == Failed { break }
                    }
                    Err(e) => {
                        @phase = Failed
                        return Err(e)
                    }
                }
            }
        }
    }
    // Drop the consumed prefix. Rebinding @inbound to a shorter slice would
    // not stick (D326 R6: a heap handle is passed as the handle) — mutate
    // through truncate/append instead.
    if pos > 0 {
        mut rest []u8 = []u8.new(cap: @inbound.len() - pos)
        rest.append(@inbound[pos..])
        @inbound.truncate(0)
        @inbound.append(rest)
    }
    Ok(events)
}

// ──────────────────────────────────────────────────────────────────────────
// Dispatch — one gate per server message. Split into two sequential matches
// (connection-level messages, then query-progress messages) on purpose: a
// single 18-arm match on this enum loses arms at the C-codegen stage of a
// merged compilation unit (observed: exactly 14 of 18 arms emitted, the
// missing set varying with the source; repro-local/enum_arm_drop). Each
// match here stays at 11 arms; a `_` arm is always present.
// ──────────────────────────────────────────────────────────────────────────

fn Session mut @dispatch(msg ServerMessage, mut events []PgEvent) -> Result[(), PostgresError] {
    ro r = match msg {
        // Allowed in every phase: the server announces parameters and
        // notices whenever it likes.
        ParameterStatus { name, value } => {
            events.push(PgEvent.Parameter { name, value })
            Ok(())
        }
        NoticeResponse { fields } => {
            events.push(PgEvent.Notice { fields })
            Ok(())
        }

        // ErrorResponse: fatal during authentication, an event mid-query
        // (then skip to ReadyForQuery), fatal outside any exchange.
        // Value-position matches: `return` inside a statement-position match
        // arm mislowers the match slot to the function's Result type and the
        // C build fails (repro-local/match_arm_return).
        ErrorResponse { fields } => match @phase {
            Authenticating => Err(PostgresError { kind: Auth { what: "server rejected authentication (SQLSTATE ${sqlstate(fields)}): ${error_message(fields)}" } })
            Startup => {
                events.push(PgEvent.QueryError { sqlstate: sqlstate(fields), message: error_message(fields) })
                @phase = Failed
                Ok(())
            }
            QuerySimple | QueryExtended => {
                if !@in_error {
                    @in_error = true
                    events.push(PgEvent.QueryError { sqlstate: sqlstate(fields), message: error_message(fields) })
                }
                Ok(())
            }
            Ready => Err(@proto("ErrorResponse while idle"))
            Closed | Failed => Ok(())
        }

        ReadyForQuery { status } => match @phase {
            Authenticating => Err(@proto("ReadyForQuery during authentication"))
            Startup => {
                @txn_status = status
                @phase = Ready
                events.push(PgEvent.Ready { status })
                Ok(())
            }
            QuerySimple | QueryExtended => {
                @txn_status = status
                @phase = Ready
                @expect_rows = false
                @in_error = false
                events.push(PgEvent.Ready { status })
                Ok(())
            }
            Ready => Err(@proto("ReadyForQuery while idle"))
            Closed | Failed => Ok(())
        }

        BackendKeyData { process_id, secret_key } => {
            if @phase != Startup {
                return Err(@proto("BackendKeyData outside the startup phase"))
            }
            @backend_pid = process_id
            @backend_key = secret_key
            events.push(PgEvent.BackendKey { process_id, secret_key })
            Ok(())
        }

        AuthenticationOk => {
            if @phase != Authenticating {
                return Err(@proto("AuthenticationOk outside the authentication phase"))
            }
            @phase = Startup
            events.push(PgEvent.Authenticated)
            Ok(())
        }
        AuthenticationCleartextPassword => {
            if @phase != Authenticating {
                return Err(@proto("cleartext password request outside the authentication phase"))
            }
            @outbound.append(ClientMessage.password(@password))
            Ok(())
        }
        AuthenticationMd5Password { salt } => {
            if @phase != Authenticating {
                return Err(@proto("MD5 password request outside the authentication phase"))
            }
            @outbound.append(ClientMessage.password(md5_response(@user, @password, salt)))
            Ok(())
        }
        AuthenticationSasl { mechanisms } => {
            if @phase != Authenticating {
                return Err(@proto("SASL request outside the authentication phase"))
            }
            mut offered = false
            for m in mechanisms {
                if m == "SCRAM-SHA-256" {
                    offered = true
                }
            }
            if !offered {
                return Err(PostgresError { kind: Auth { what: "server offers no SCRAM-SHA-256" } })
            }
            mut client = ScramClient.new(@user, @password, @client_nonce)
            @outbound.append(ClientMessage.sasl_initial("SCRAM-SHA-256", client.client_first().bytes()))
            @scram = Some(client)
            Ok(())
        }
        AuthenticationSaslContinue { data } => {
            if @phase != Authenticating {
                return Err(@proto("SASL challenge outside the authentication phase"))
            }
            mut client = match @scram {
                Some(c) => c
                None => return Err(@proto("SASL challenge before the mechanism started"))
            }
            ro server_first = match data.to_str() {
                Ok(s) => s
                Err(_) => return Err(PostgresError { kind: Auth { what: "SASL challenge is not UTF-8" } })
            }
            ro client_final = client.respond_server_first(server_first)?
            @scram = Some(client)
            @outbound.append(ClientMessage.sasl_response(client_final.bytes()))
            Ok(())
        }
        AuthenticationSaslFinal { data } => {
            if @phase != Authenticating {
                return Err(@proto("SASL final outside the authentication phase"))
            }
            mut client = match @scram {
                Some(c) => c
                None => return Err(@proto("SASL final before the mechanism started"))
            }
            ro server_final = match data.to_str() {
                Ok(s) => s
                Err(_) => return Err(PostgresError { kind: Auth { what: "SASL final is not UTF-8" } })
            }
            ro vr = client.verify_server_final(server_final)
            @scram = Some(client)
            vr?
            Ok(())
        }

        // Query-progress messages and anything unknown: second match.
        _ => @dispatch_query(msg, events)
    }
    // `r?` as the function tail does not re-wrap the value into Ok at the
    // C-codegen stage (the Ok payload is returned raw); an explicit tail
    // does (same class as repro-local/match_arm_return).
    r?
    Ok(())
}

// Second half of dispatch: the query-progress messages (allowed mid-query;
// skipped while recovering from an error until ReadyForQuery closes the
// cycle) and the unknown-message fallback. Seven arms + `_`.
fn Session mut @dispatch_query(msg ServerMessage, mut events []PgEvent) -> Result[(), PostgresError] {
    ro r = match msg {
        // During error-skip every query-progress message is ignored until
        // the ReadyForQuery arm in the first match closes the cycle.
        RowDescription { .. } => {
            if @in_error { return Ok(()) }
            if @phase == QueryExtended {
                if @ext_stage != ExtDescribe {
                    return Err(@proto("RowDescription out of order in the extended cycle"))
                }
                @ext_stage = ExtExecute
            } else if @phase != QuerySimple {
                return Err(@proto("RowDescription outside a query"))
            }
            @expect_rows = true
            events.push(PgEvent.RowDesc { fields: row_fields_of(msg) })
            Ok(())
        }
        DataRow { .. } => {
            if @in_error { return Ok(()) }
            mut allowed = false
            if @phase == QuerySimple {
                allowed = @expect_rows
            } else if @phase == QueryExtended {
                allowed = @ext_stage == ExtExecute && @expect_rows
            } else {
                return Err(@proto("DataRow outside a query"))
            }
            if !allowed {
                return Err(@proto("DataRow before RowDescription"))
            }
            events.push(PgEvent.Row { values: row_values_of(msg) })
            Ok(())
        }
        CommandComplete { .. } => {
            if @in_error { return Ok(()) }
            if @phase == QueryExtended {
                if @ext_stage != ExtExecute {
                    return Err(@proto("CommandComplete out of order in the extended cycle"))
                }
            } else if @phase != QuerySimple {
                return Err(@proto("CommandComplete outside a query"))
            }
            events.push(Complete { tag: command_tag_of(msg) })
            Ok(())
        }
        EmptyQueryResponse => {
            if @in_error { return Ok(()) }
            if @phase == QueryExtended {
                if @ext_stage != ExtExecute {
                    return Err(@proto("EmptyQueryResponse out of order in the extended cycle"))
                }
            } else if @phase != QuerySimple {
                return Err(@proto("EmptyQueryResponse outside a query"))
            }
            events.push(PgEvent.EmptyQuery)
            Ok(())
        }
        ParseComplete => {
            if @in_error { return Ok(()) }
            if @phase != QueryExtended || @ext_stage != ExtParse {
                return Err(@proto("ParseComplete outside the extended parse step"))
            }
            @ext_stage = ExtBind
            Ok(())
        }
        BindComplete => {
            if @in_error { return Ok(()) }
            if @phase != QueryExtended || @ext_stage != ExtBind {
                return Err(@proto("BindComplete outside the extended bind step"))
            }
            @ext_stage = ExtDescribe
            Ok(())
        }
        NoData => {
            if @in_error { return Ok(()) }
            if @phase != QueryExtended || @ext_stage != ExtDescribe {
                return Err(@proto("NoData outside the extended describe step"))
            }
            @ext_stage = ExtExecute
            Ok(())
        }
        // Asynchronous: a notification is legal in EVERY phase (even during
        // authentication or mid-error-skip) and never changes the phase.
        NotificationResponse { process_id, channel, payload } => {
            events.push(PgEvent.Notification { pid: process_id, channel, payload })
            Ok(())
        }
        // Connection-level messages never reach this match (the first match
        // handles or rejects them); the catch-all keeps it exhaustive.
        _ => Err(@proto("message re-dispatched"))
    }
    r?
    Ok(())
}

// ──────────────────────────────────────────────────────────────────────────
// Small helpers
// ──────────────────────────────────────────────────────────────────────────

// Short constructor for the Protocol error kind, used at every gate above.
fn Session @proto(what str) -> PostgresError =>
    { kind: Protocol { what } }

// SQLSTATE code (ErrorResponse field `C`), empty when the server omitted it.
fn sqlstate(fields []ErrorField) -> str {
    for f in fields {
        if f.code == 'C' as u8 {
            return f.value
        }
    }
    ""
}

// Human message (ErrorResponse field `M`), empty when omitted.
fn error_message(fields []ErrorField) -> str {
    for f in fields {
        if f.code == 'M' as u8 {
            return f.value
        }
    }
    ""
}



// TEMP-DIAG: bisect only, not API. Mirror of PgEvent for repro-local.
export type SE2 enum
    | SAuthenticated
    | SParameterStatus { name str, value str }
    | SBackendKey { process_id int, secret_key int }
    | SReady { status u8 }
    | SRowDescription { fields []RowField }
    | SDataRow { values []ParamValue }
    | SCommandComplete { tag str }
    | SEmptyQuery
    | SNotice { fields []ErrorField }
    | SQueryError { sqlstate str, fields []ErrorField }

// TEMP-DIAG: exact copy of PgEvent under a different name.
export type Event2 enum
    | Authenticated
    | Parameter { name str, value str }
    | BackendKey { process_id int, secret_key int }
    | Ready { status u8 }
    | RowDesc { fields []RowField }
    | Row { values []ParamValue }
    | Complete { tag str }
    | EmptyQuery
    | Notice { fields []ErrorField }
    | QueryError { sqlstate str, fields []ErrorField }

// Payload extractors. The big dispatch match mis-extracts vec payloads from
// enum values in some merged compilations (garbage handles downstream);
// small single-purpose matches lower correctly (same class as the dropped
// arms — repro-local/enum_arm_drop).
fn row_fields_of(m ServerMessage) -> []RowField {
    match m {
        ServerMessage.RowDescription { fields } => fields
        _ => []RowField.new()
    }
}

fn row_values_of(m ServerMessage) -> []ParamValue {
    match m {
        ServerMessage.DataRow { values } => values
        _ => []ParamValue.new()
    }
}

fn command_tag_of(m ServerMessage) -> str {
    match m {
        ServerMessage.CommandComplete { tag } => tag
        _ => ""
    }
}
