    while cut < step1.len() {
        assert(scram_run(1, cut) == whole, "scram step1 cut ${cut}")
        cut += 1
    }
    ro step2 = sasl_final("v=XjTu3KBABgY/OKnhaQwxJb9Vbt2Fj1v+lPuMzeAcqSk=")
    mut cut = 1
    while cut < step2.len() {
        assert(scram_run(2, cut) == whole, "scram step2 cut ${cut}")
        cut += 1
    }
    ro step3 = cat(auth_ok(), ready('I' as u8))
    mut cut = 1
    while cut < step3.len() {
        assert(scram_run(3, cut) == whole, "scram step3 cut ${cut}")
        cut += 1
    }
}

fn ext_error_run(split_step int, cut int) -> str {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro step0 = cat(auth_ok(), ready('I' as u8))
    ro step1 = cat3(parse_complete(), error_response("42601", "syntax error"), ready('I' as u8))
    ro step2 = cat3(row_desc("a"), data_row_text("7"), cat(cmd_complete("SELECT 1"), ready('I' as u8)))
    mut out = ""
    if split_step == 0 && cut >= 0 {
        mut all = match s.feed(step0[..cut]) {
            Ok(e) => e
            Err(e) => {
                s.close()
                return "!${e}"
            }
        }
        ro evs2 = match s.feed(step0[cut..]) {
            Ok(e2) => e2
            Err(e) => {
                s.close()
                return "${render(all)}!${e}"
            }
        }
        all.append(evs2)
        out = "${out}${render(all)}"
    } else {
        match s.feed(step0) {
            Ok(evs) => { out = "${out}${render(evs)}" }
            Err(e) => {
                s.close()
                return "${out}!${e}"
            }
        }
    }
    match s.query_extended("SELECT bogus", [], [], []) {
        Ok(()) => ()
        Err(e) => assert(false, "extended query errored: ${e}")
    }
    if split_step == 1 && cut >= 0 {
        mut all = match s.feed(step1[..cut]) {
            Ok(e) => e
            Err(e) => {
                s.close()
                return "!${e}"
            }
        }
        ro evs2 = match s.feed(step1[cut..]) {
            Ok(e2) => e2
            Err(e) => {
                s.close()
                return "${render(all)}!${e}"
            }
        }
        all.append(evs2)
        out = "${out}${render(all)}"
    } else {
        match s.feed(step1) {
            Ok(evs) => { out = "${out}${render(evs)}" }
            Err(e) => {
                s.close()
                return "${out}!${e}"
            }
        }
    }
    match s.query("SELECT 1") {
        Ok(()) => ()
        Err(e) => assert(false, "query errored: ${e}")
    }
    if split_step == 2 && cut >= 0 {
        mut all = match s.feed(step2[..cut]) {
            Ok(e) => e
            Err(e) => {
                s.close()
                return "!${e}"
            }
        }
        ro evs2 = match s.feed(step2[cut..]) {
            Ok(e2) => e2
            Err(e) => {
                s.close()
                return "${render(all)}!${e}"
            }
        }
        all.append(evs2)
        out = "${out}${render(all)}"
    } else {
        match s.feed(step2) {
            Ok(evs) => { out = "${out}${render(evs)}" }
            Err(e) => {
                s.close()
                return "${out}!${e}"
            }
        }
    }
    s.close()
    out
}

