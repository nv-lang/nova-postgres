// ---- checks ported from src\session_empty_test.nv ----


// empty query
fn chk_criterion_2_empty_query() -> () {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro e1 = match s.feed(cat(auth_ok(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "entry errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(e1.len() == 2, "empty query: entry events")
    match s.query("   ") {
        Ok(()) => ()
        Err(e) => assert(false, "query errored: ${e}")
    }
    ro evs = match s.feed(cat(empty_query(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "empty query errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(evs.len() == 2, "empty query: event count")
    assert(ev(evs[0]) == "empty", "empty query ev0")
    assert(ev(evs[1]) == "ready:I", "empty query ev1")
    assert(s.drain() == cat(startup_ref(), frame('Q' as u8, cstr("   "))), "empty query: client bytes")
    s.close()
}



// ---- checks ported from src\session_ext_error_test.nv ----


// error in extended query and recovery on Sync
fn ext_error_server() -> []u8 =>
    cat3(parse_complete(), error_response("42601", "syntax error"), ready('I' as u8))

fn chk_criterion_2_error_in_extended_query_and_recovery() -> () {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro e1 = match s.feed(cat(auth_ok(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            println("DIAG EXTERR ${e}")
            assert(false, "entry errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(e1.len() == 2, "ext error: entry events")
    match s.query_extended("SELECT bogus", [], [], []) {
        Ok(()) => ()
        Err(e) => assert(false, "extended query errored: ${e}")
    }
    ro evs = match s.feed(ext_error_server()) {
        Ok(e) => e
        Err(e) => {
            assert(false, "extended error round errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(evs.len() == 2, "ext error: event count")
    assert(ev(evs[0]) == "error:42601:syntax error", "ext error ev0")
    assert(ev(evs[1]) == "ready:I", "ext error ev1")
    // Recovery: a plain query works afterwards.
    match s.query("SELECT 1") {
        Ok(()) => ()
        Err(e) => assert(false, "query after error errored: ${e}")
    }
    ro ok_rows = cat3(row_desc("a"), data_row_text("7"), cat(cmd_complete("SELECT 1"), ready('I' as u8)))
    ro evs2 = match s.feed(ok_rows) {
        Ok(e) => e
        Err(e) => {
            println("DIAG2 ${e}")
            assert(false, "errored")
            []PgEvent.new()
        }
    }
    assert(evs2.len() == 4, "ext error: recovery events")
    assert(s.drain() == cat(cat(startup_ref(), extended_ref_bogus()), frame('Q' as u8, cstr("SELECT 1"))), "ext error: client bytes")
    s.close()
}



// ---- checks ported from src\session_extended_test.nv ----


// ParseComplete, BindComplete, RowDescription (two binary int4 columns),
// DataRow (binary 42, NULL), CommandComplete, ReadyForQuery.
fn extended_server() -> []u8 =>
    cat4(parse_complete(), bind_complete(), row_desc_bin2("?column?", "?column?"), cat(data_row_bin_null(x"00 00 00 80"), cat(cmd_complete("SELECT 1"), ready('I' as u8))))

fn chk_criterion_2_extended_query_with_null_parameter_a() -> () {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro e1 = match s.feed(cat(auth_ok(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "entry errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(e1.len() == 2, "extended: entry events")
    // Built by push, not a vec literal: a record carrying Option[[]u8]
    // inside a vec literal is the none_slice_lower defect shape.
    mut ps []ParamValue = []ParamValue.new()
    ps.push(ParamValue.null())
    match s.query_extended("SELECT 42, $1::int", [], ps, [1]) {
        Ok(()) => ()
        Err(e) => assert(false, "extended query errored: ${e}")
    }
    ro evs = match s.feed(extended_server()) {
        Ok(e) => e
        Err(e) => {
            assert(false, "extended round errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(evs.len() == 4, "extended: event count")
    assert(ev(evs[0]) == "rowdesc:2:?column?:1", "extended ev0")
    assert(ev(evs[1]) == "row|some:bin:4|null", "extended ev1")
    assert(ev(evs[2]) == "cc:SELECT 1", "extended ev2")
    assert(ev(evs[3]) == "ready:I", "extended ev3")
    assert(s.drain() == cat(startup_ref(), extended_ref()), "extended: client bytes")
    s.close()
}

fn chk_criterion_2_cut_extended_query_survives_every_cu() -> () {
    ro whole = feed_extended(-1)
    mut cut = 1
    while cut < extended_server().len() {
        assert(feed_extended(cut) == whole, "extended cut at ${cut}")
        cut += 1
    }
}

fn feed_extended(cut int) -> str {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro _e = match s.feed(cat(auth_ok(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "entry errored: ${e}")
            []PgEvent.new()
        }
    }
    mut ps []ParamValue = []ParamValue.new()
    ps.push(ParamValue.null())
    match s.query_extended("SELECT 42, $1::int", [], ps, [1]) {
        Ok(()) => ()
        Err(e) => assert(false, "extended query errored: ${e}")
    }
    ro server = extended_server()
    ro evs = if cut < 0 {
        match s.feed(server) {
            Ok(e) => e
            Err(e) => {
                s.close()
                return "ERR:${e}"
            }
        }
    } else {
        mut all = match s.feed(server[..cut]) {
            Ok(e) => e
            Err(e) => {
                s.close()
                return "ERR:${e}"
            }
        }
        match s.feed(server[cut..]) {
            Ok(e2) => {
                all.append(e2)
                all
            }
            Err(e) => {
                s.close()
                return "ERR:${e}"
            }
        }
    }
    mut out = ""
    mut i = 0
    while i < evs.len() {
        out = "${out};${ev(evs[i])}"
        i += 1
    }
    s.close()
    out
}


// ---- checks ported from src\session_notice_test.nv ----


// NoticeResponse mid query
fn chk_criterion_2_notice_mid_query() -> () {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro e1 = match s.feed(cat(auth_ok(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "entry errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(e1.len() == 2, "notice: entry events")
    match s.query("SELECT 1") {
        Ok(()) => ()
        Err(e) => assert(false, "query errored: ${e}")
    }
    ro server = cat3(notice_response("index blah does not exist"), cat3(row_desc("a"), data_row_text("1"), cmd_complete("SELECT 1")), ready('I' as u8))
    ro evs = match s.feed(server) {
        Ok(e) => e
        Err(e) => {
            assert(false, "notice round errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(evs.len() == 5, "notice: event count")
    assert(ev(evs[0]) == "notice:index blah does not exist", "notice ev0")
    assert(ev(evs[1]) == "rowdesc:1:a:0", "notice ev1")
    assert(ev(evs[2]) == "row|some:1", "notice ev2")
    assert(ev(evs[3]) == "cc:SELECT 1", "notice ev3")
    assert(ev(evs[4]) == "ready:I", "notice ev4")
    s.close()
}



// ---- checks ported from src\session_ps_test.nv ----


// ParameterStatus mid session (while idle, outside any query)
fn chk_criterion_2_parameter_status_mid_session() -> () {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro e1 = match s.feed(cat(auth_ok(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "entry errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(e1.len() == 2, "ps mid: entry events")
    ro evs = match s.feed(param_status("application_name", "myapp")) {
        Ok(e) => e
        Err(e) => {
            assert(false, "parameter status errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(evs.len() == 1, "ps mid: event count")
    assert(ev(evs[0]) == "ps:application_name=myapp", "ps mid ev0")
    match s.query("SELECT 1") {
        Ok(()) => ()
        Err(e) => assert(false, "query errored: ${e}")
    }
    ro ok_rows = cat3(row_desc("a"), data_row_text("1"), cat(cmd_complete("SELECT 1"), ready('I' as u8)))
    ro evs2 = match s.feed(ok_rows) {
        Ok(e) => e
        Err(e) => {
            assert(false, "query round errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(evs2.len() == 4, "ps mid: query events")
    s.close()
}



// ---- checks ported from src\session_recovery_test.nv ----


// error mid simple query and recovery on ReadyForQuery
fn recovery_server() -> []u8 =>
    cat3(row_desc("a"), error_response("42601", "syntax error"), ready('I' as u8))

fn chk_criterion_2_error_mid_simple_query_and_recovery() -> () {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro e1 = match s.feed(cat(auth_ok(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "entry errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(e1.len() == 2, "recovery: entry events")
    match s.query("SELECT 1") {
        Ok(()) => ()
        Err(e) => assert(false, "query errored: ${e}")
    }
    // The error lands after a RowDescription; the DataRow the server would
    // have sent is skipped together with everything up to ReadyForQuery.
    ro evs = match s.feed(recovery_server()) {
        Ok(e) => e
        Err(e) => {
            assert(false, "error round errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(evs.len() == 3, "recovery: event count")
    assert(ev(evs[0]) == "rowdesc:1:a:0", "recovery ev0")
    assert(ev(evs[1]) == "error:42601:syntax error", "recovery ev1")
    assert(ev(evs[2]) == "ready:I", "recovery ev2")
    // The session is Ready again and runs the next query.
    match s.query("SELECT 1") {
        Ok(()) => ()
        Err(e) => assert(false, "second query errored: ${e}")
    }
    ro ok_rows = cat3(row_desc("a"), data_row_text("9"), cat(cmd_complete("SELECT 1"), ready('I' as u8)))
    ro evs2 = match s.feed(ok_rows) {
        Ok(e) => e
        Err(e) => {
            assert(false, "recovery round errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(evs2.len() == 4, "recovery: second round events")
    assert(ev(evs2[0]) == "rowdesc:1:a:0", "recovery ev2-0")
    assert(ev(evs2[1]) == "row|some:9", "recovery ev2-1")
    assert(ev(evs2[2]) == "cc:SELECT 1", "recovery ev2-2")
    assert(ev(evs2[3]) == "ready:I", "recovery ev2-3")
    ro want = cat(startup_ref(), frame('Q' as u8, cstr("SELECT 1")))
    assert(s.drain() == cat(want, frame('Q' as u8, cstr("SELECT 1"))), "recovery: client bytes")
    s.close()
}

fn chk_criterion_2_cut_error_recovery_survives_every_cu() -> () {
    ro whole = feed_recovery(-1)
    mut cut = 1
    while cut < recovery_server().len() {
        assert(feed_recovery(cut) == whole, "recovery cut at ${cut}")
        cut += 1
    }
}

fn feed_recovery(cut int) -> str {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro _e = match s.feed(cat(auth_ok(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "entry errored: ${e}")
            []PgEvent.new()
        }
    }
    match s.query("SELECT 1") {
        Ok(()) => ()
        Err(e) => assert(false, "query errored: ${e}")
    }
    ro server = recovery_server()
    ro evs = if cut < 0 {
        match s.feed(server) {
            Ok(e) => e
            Err(e) => {
                s.close()
                return "ERR:${e}"
            }
        }
    } else {
        mut all = match s.feed(server[..cut]) {
            Ok(e) => e
            Err(e) => {
                s.close()
                return "ERR:${e}"
            }
        }
        match s.feed(server[cut..]) {
            Ok(e2) => {
                all.append(e2)
                all
            }
            Err(e) => {
                s.close()
                return "ERR:${e}"
            }
        }
    }
    mut out = ""
    mut i = 0
    while i < evs.len() {
        out = "${out};${ev(evs[i])}"
        i += 1
    }
    s.close()
    out
}



// ---- checks ported from src\session_rules_test.nv ----


// ──────────────────────────────────────────────────────────────────────────
// Criterion 3: illegal transitions are structural errors, never panics
// ──────────────────────────────────────────────────────────────────────────

fn chk_criterion_3_datarow_before_rowdescription_is_a_p() -> () {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro e1 = match s.feed(cat(auth_ok(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "entry errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(e1.len() == 2, "entry events")
    match s.query("SELECT 1") {
        Ok(()) => ()
        Err(e) => assert(false, "query errored: ${e}")
    }
    ro e = match s.feed(data_row_text("1")) {
        Ok(_) => {
            assert(false, "DataRow before RowDescription decoded fine")
            PostgresError { kind: Protocol { what: "unreachable" } }
        }
        Err(e) => e
    }
    match e.kind {
        Protocol { what } => assert(what == "DataRow before RowDescription", "wrong message")
        _ => assert(false, "wrong error kind")
    }
    s.close()
}

fn chk_criterion_3_readyforquery_during_authentication_() -> () {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro e = match s.feed(ready('I' as u8)) {
        Ok(_) => {
            assert(false, "ReadyForQuery during authentication accepted")
            PostgresError { kind: Protocol { what: "unreachable" } }
        }
        Err(e) => e
    }
    match e.kind {
        Protocol { what } => assert(what == "ReadyForQuery during authentication", "wrong message")
        _ => assert(false, "wrong error kind")
    }
    s.close()
}

fn chk_criterion_3_query_message_while_idle_is_a_protoc() -> () {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro e1 = match s.feed(cat(auth_ok(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "entry errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(e1.len() == 2, "entry events")
    match s.query("SELECT 1") {
        Ok(()) => ()
        Err(e) => assert(false, "query errored: ${e}")
    }
    // Finish the query properly, then send CommandComplete with no query in
    // flight.
    ro evs2 = match s.feed(cat3(row_desc("a"), data_row_text("1"), cat(cmd_complete("SELECT 1"), ready('I' as u8)))) {
        Ok(e) => e
        Err(e) => {
            println("IDLE round err ${e}")
            assert(false, "query round errored")
            []PgEvent.new()
        }
    }
    assert(evs2.len() == 4, "query round events")
    ro e = match s.feed(cmd_complete("SELECT 1")) {
        Ok(_) => {
            assert(false, "CommandComplete while idle accepted")
            PostgresError { kind: Protocol { what: "unreachable" } }
        }
        Err(e) => e
    }
    match e.kind {
        Protocol { what } => assert(what == "CommandComplete outside a query", "wrong message")
        _ => assert(false, "wrong error kind")
    }
    s.close()
}

fn chk_criterion_3_a_failed_session_refuses_further_fee() -> () {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    match s.feed(ready('I' as u8)) {
        Ok(_) => assert(false, "ReadyForQuery during authentication accepted")
        Err(_) => ()
    }
    match s.feed(auth_ok()) {
        Ok(_) => assert(false, "feed on failed session accepted")
        Err(_) => ()
    }
    s.close()
}

// ──────────────────────────────────────────────────────────────────────────
// Criterion 4: the transaction status from ReadyForQuery
// ──────────────────────────────────────────────────────────────────────────

fn chk_criterion_4_begin_t_error_inside_e_rollback_i() -> () {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro e1 = match s.feed(cat(auth_ok(), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "entry errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(e1.len() == 2, "txn: entry events")
    match s.query("BEGIN") {
        Ok(()) => ()
        Err(e) => assert(false, "BEGIN errored: ${e}")
    }
    ro evs = match s.feed(cat(cmd_complete("BEGIN"), ready('T' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "BEGIN round errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(evs.len() == 2, "txn: BEGIN events")
    assert(s.transaction_status() == 'T' as u8, "status after BEGIN")
    match s.query("SELECT bogus") {
        Ok(()) => ()
        Err(e) => assert(false, "query errored: ${e}")
    }
    ro evs2 = match s.feed(cat(error_response("42601", "syntax error"), ready('E' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "error round errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(evs2.len() == 2, "txn: error events")
    assert(s.transaction_status() == 'E' as u8, "status after error inside transaction")
    match s.query("ROLLBACK") {
        Ok(()) => ()
        Err(e) => assert(false, "ROLLBACK errored: ${e}")
    }
    ro evs3 = match s.feed(cat(cmd_complete("ROLLBACK"), ready('I' as u8))) {
        Ok(e) => e
        Err(e) => {
            assert(false, "ROLLBACK round errored: ${e}")
            []PgEvent.new()
        }
    }
    assert(evs3.len() == 2, "txn: ROLLBACK events")
    assert(s.transaction_status() == 'I' as u8, "status after ROLLBACK")
    s.close()
}

// ──────────────────────────────────────────────────────────────────────────
// Close
// ──────────────────────────────────────────────────────────────────────────

fn chk_close_returns_the_final_flush_with_terminate() -> () {
    consume s = Session.new("postgres", "smoke", "postgres", "n")
    ro startup = s.drain()
    assert(startup == startup_ref(), "startup bytes before close")
    // Consume: the session ends here. Further feeds are refused by the
    // type system, not by a runtime check.
    ro fin = s.close()
    assert(fin == ClientMessage.terminate(), "Terminate not in the final flush")
}


