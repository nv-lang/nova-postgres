fn scram_run(split_step int, cut int) -> str {
    ro server_first = "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=1"
    consume s = Session.new("user", "pencil", "db", "rOprNGfwEbeRWgbNEkqO")
    ro step0 = auth_sasl()
    ro step1 = sasl_continue(server_first)
    ro step2 = sasl_final("v=XjTu3KBABgY/OKnhaQwxJb9Vbt2Fj1v+lPuMzeAcqSk=")
    ro step3 = cat(auth_ok(), ready('I' as u8))
    mut out = ""
    if split_step == 0 && cut >= 0 {
        mut all = match s.feed(step0[..cut]) {
            Ok(e) => e
            Err(e) => {
                s.close()
                return "!${e}"
            }
        }
        ro evs2 = match s.feed(step0[cut..]) {
            Ok(e2) => e2
            Err(e) => {
                s.close()
                return "${render(all)}!${e}"
            }
        }
        all.append(evs2)
        out = "${out}${render(all)}"
    } else {
        match s.feed(step0) {
            Ok(evs) => { out = "${out}${render(evs)}" }
            Err(e) => {
                s.close()
                return "${out}!${e}"
            }
        }
    }
    if split_step == 1 && cut >= 0 {
        mut all = match s.feed(step1[..cut]) {
            Ok(e) => e
            Err(e) => {
                s.close()
                return "!${e}"
            }
        }
        ro evs2 = match s.feed(step1[cut..]) {
            Ok(e2) => e2
            Err(e) => {
                s.close()
                return "${render(all)}!${e}"
            }
        }
        all.append(evs2)
        out = "${out}${render(all)}"
    } else {
        match s.feed(step1) {
            Ok(evs) => { out = "${out}${render(evs)}" }
            Err(e) => {
                s.close()
                return "${out}!${e}"
            }
        }
    }
    if split_step == 2 && cut >= 0 {
        mut all = match s.feed(step2[..cut]) {
            Ok(e) => e
            Err(e) => {
                s.close()
                return "!${e}"
            }
        }
        ro evs2 = match s.feed(step2[cut..]) {
            Ok(e2) => e2
            Err(e) => {
                s.close()
                return "${render(all)}!${e}"
            }
        }
        all.append(evs2)
        out = "${out}${render(all)}"
    } else {
        match s.feed(step2) {
            Ok(evs) => { out = "${out}${render(evs)}" }
            Err(e) => {
                s.close()
                return "${out}!${e}"
            }
        }
    }
    if split_step == 3 && cut >= 0 {
        mut all = match s.feed(step3[..cut]) {
            Ok(e) => e
            Err(e) => {
                s.close()
                return "!${e}"
            }
        }
        ro evs2 = match s.feed(step3[cut..]) {
            Ok(e2) => e2
            Err(e) => {
                s.close()
                return "${render(all)}!${e}"
            }
        }
        all.append(evs2)
        out = "${out}${render(all)}"
    } else {
        match s.feed(step3) {
            Ok(evs) => { out = "${out}${render(evs)}" }
            Err(e) => {
                s.close()
                return "${out}!${e}"
            }
        }
    }
    s.close()
    out
}

fn chk_criterion_2_cut_scram_entry_survives_every_cut() -> () {
    ro whole = scram_run(-1, -1)
    ro server_first = "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=1"
