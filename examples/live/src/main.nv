// examples/live/src/main.nv — plan 286 §Д8б criterion 5: the live run against
// a throwaway PostgreSQL 15 in Docker on a Docker-chosen free port.
//
//   docker run --rm -d --name nova-pg-d8b -e POSTGRES_PASSWORD=smoke -p 127.0.0.1::5432 postgres:15
//   docker port nova-pg-d8b 5432          # -> 127.0.0.1:<port>
//   ./nova.sh build examples/live/src/main.nv -o target/live.exe
//   ./target/live.exe 127.0.0.1 <port>
//   docker stop nova-pg-d8b
//
// Flow (each step prints a line; the last line is D8B LIVE OK):
//   1. connect — SCRAM-SHA-256 authentication
//   2. SELECT 1 — DataRow '1'
//   3. SELECT generate_series(1, 10000) — exactly 10000 rows
//   4. a syntax error — QueryError with SQLSTATE 42601, structurally; the
//      SAME connection then runs SELECT 1 again
//   5. extended SELECT $1::int + 1 with '41' — DataRow '42'
//   6. extended query with a NULL parameter — DataRow NULL
//   7. BEGIN / ROLLBACK — transaction status T then I

module main

import std.net.{real_net}
import std.os.{real_os, args}
import postgres.{PgEvent, ParamValue, ErrorField, Row}
import postgres.pgnet.{Connection, connect}

fn main() {
    with Os = real_os() {
        ro argv = args()
        ro host = argv.get(1) ?? "127.0.0.1"
        ro port = (argv.get(2) ?? "5432").to_int().ok() ?? 5432
        with Net = real_net() {
            match live(host, port) {
                Ok(detail) => println("D8B LIVE OK: ${detail}")
                Err(reason) => println("D8B LIVE FAIL: ${reason}")
            }
        }
    }
}

fn live(host str, port int) Net Random -> Result[str, str] {
    consume conn = match connect(host, port, "postgres", "smoke", "postgres") {
        Ok(consume c) => c
        Err(e) => return Err("connect: ${e}")
    }
    // 1: connect returns only after AuthenticationOk + ReadyForQuery, so the
    // connection itself proves the authentication exchange (SCRAM-SHA-256
    // against this server).
    println("live: connected (authentication passed)")

    // 2: SELECT 1
    ro one = match conn.simple_query("SELECT 1") {
        Ok(evs) => single_text_value(evs, "step 2")?
        Err(e) => return Err(e)
    }
    if one != "1" {
        return Err("step 2: expected '1', got '${one}'")
    }
    println("live: SELECT 1 -> '${one}'")

    // 3: ten thousand rows
    ro evs = match conn.simple_query("SELECT generate_series(1, 10000)") {
        Ok(e) => e
        Err(e) => return Err(e)
    }
    mut rows = 0
    mut i = 0
    while i < evs.len() {
        match evs[i] {
            Row { .. } => { rows += 1 }
            _ => ()
        }
        i += 1
    }
    if rows != 10000 {
        return Err("step 3: expected 10000 rows, got ${rows}")
    }
    println("live: generate_series -> ${rows} rows")

    // 4: syntax error is a structural event with SQLSTATE, then recovery
    ro evs2 = match conn.simple_query("SELEC bogus") {
        Ok(e) => e
        Err(e) => return Err(e)
    }
    ro sqlstate = find_sqlstate(evs2)
    if sqlstate != "42601" {
        return Err("step 4: expected SQLSTATE 42601, got '${sqlstate}'")
    }
    println("live: syntax error surfaced as SQLSTATE ${sqlstate}")
    ro one2 = match conn.simple_query("SELECT 1") {
        Ok(e) => single_text_value(e, "step 4")?
        Err(e) => return Err(e)
    }
    if one2 != "1" {
        return Err("step 4: recovery query expected '1', got '${one2}'")
    }
    println("live: same connection after the error -> '${one2}'")

    // 5: extended query with a parameter
    mut ps []ParamValue = []ParamValue.new()
    ps.push(ParamValue.text("41"))
    ro evs3 = match conn.extended_query("SELECT $1::int + 1", ps) {
        Ok(e) => e
        Err(e) => return Err(e)
    }
    ro sum = single_text_value(evs3, "step 5")?
    if sum != "42" {
        return Err("step 5: expected '42', got '${sum}'")
    }
    println("live: extended SELECT \$1::int + 1 with '41' -> '${sum}'")

    // 6: NULL parameter
    mut pn []ParamValue = []ParamValue.new()
    pn.push(ParamValue.null())
    ro evs4 = match conn.extended_query("SELECT $1::int", pn) {
        Ok(e) => e
        Err(e) => return Err(e)
    }
    if !has_null_row(evs4) {
        return Err("step 6: expected a DataRow with a NULL value")
    }
    println("live: extended query with NULL parameter -> NULL")

    // 7: transaction status
    ro _b = match conn.simple_query("BEGIN") {
        Ok(e) => e
        Err(e) => return Err(e)
    }
    if conn.transaction_status() != 'T' as u8 {
        return Err("step 7: expected status 'T' after BEGIN")
    }
    println("live: BEGIN -> transaction status 'T'")
    ro _r = match conn.simple_query("ROLLBACK") {
        Ok(e) => e
        Err(e) => return Err(e)
    }
    if conn.transaction_status() != 'I' as u8 {
        return Err("step 7: expected status 'I' after ROLLBACK")
    }
    println("live: ROLLBACK -> transaction status 'I'")

    match conn.close() {
        Ok(()) => ()
        Err(e) => return Err(e)
    }
    Ok("SCRAM, SELECT 1, 10000 rows, 42601 recovery, extended 42, NULL, BEGIN/ROLLBACK")
}

// The first DataRow's first value as text; a QueryError in the events is
// surfaced as an Err with its SQLSTATE.
fn single_text_value(evs []PgEvent, what str) -> Result[str, str] {
    mut i = 0
    while i < evs.len() {
        match evs[i] {
            Row { values } => {
                if values.len() < 1 {
                    return Err("${what}: DataRow has no columns")
                }
                ro v = values[0]
                match v.data {
                    Some(b) => {
                        ro s = match b.to_str() {
                            Ok(t) => t
                            Err(_) => return Err("${what}: value is not UTF-8")
                        }
                        return Ok(s)
                    }
                    None => return Err("${what}: unexpected NULL")
                }
            }
            QueryError { sqlstate, fields } => return Err("${what}: server error ${sqlstate}: ${error_text(fields)}")
            _ => ()
        }
        i += 1
    }
    Err("${what}: no DataRow in events")
}

fn find_sqlstate(evs []PgEvent) -> str {
    mut i = 0
    while i < evs.len() {
        match evs[i] {
            QueryError { sqlstate, .. } => return sqlstate
            _ => ()
        }
        i += 1
    }
    ""
}

fn has_null_row(evs []PgEvent) -> bool {
    mut i = 0
    while i < evs.len() {
        match evs[i] {
            Row { values } => {
                if values.len() > 0 {
                    ro v = values[0]
                    match v.data {
                        None => return true
                        Some(_) => ()
                    }
                }
            }
            _ => ()
        }
        i += 1
    }
    false
}

fn error_text(fields []ErrorField) -> str {
    for f in fields {
        if f.code == 'M' as u8 {
            return f.value
        }
    }
    ""
}
