// examples/live/src/main.nv — plan 286 §Д8в criteria 4 and 5: the live run
// against throwaway PostgreSQL 15 containers in Docker on Docker-chosen
// free ports.
//
//   # TLS server with a certificate from your own CA (full recipe in BRIEF-D8c.md):
//   docker run --rm -d --name nova-pg-d8c-tls -e POSTGRES_PASSWORD=smoke -p 127.0.0.1::5432 postgres:15 bash -c '...'
//   docker port nova-pg-d8c-tls 5432          # -> 127.0.0.1:<port>
//   docker cp nova-pg-d8c-tls:/var/lib/postgresql/ca.crt target/pg-ca.crt
//
//   # plain server without TLS:
//   docker run --rm -d --name nova-pg-d8c-plain -e POSTGRES_PASSWORD=smoke -p 127.0.0.1::5432 postgres:15
//   docker port nova-pg-d8c-plain 5432        # -> 127.0.0.1:<port>
//
//   ./nova.sh build examples/live/src/main.nv -o target/live.exe
//
//   # (a)+(5) TLS with the custom CA: SCRAM over TLS, the TLS version,
//   #     pg_stat_ssl -> t, the whole D8b live flow, then BEGIN -> T,
//   #     error inside -> E, ROLLBACK -> I:
//   ./target/live.exe 127.0.0.1 <tls-port> ca target/pg-ca.crt localhost
//   # (b) structured TLS error on a name the certificate does not carry
//   #     (TCP to 127.0.0.1, the certificate checked as db.example):
//   ./target/live.exe 127.0.0.1 <tls-port> mismatch target/pg-ca.crt
//   # (c) the system roots do not know our CA — structured TLS error:
//   ./target/live.exe 127.0.0.1 <tls-port> system target/pg-ca.crt localhost
//   # (d) the plain server — Require refuses structurally, Prefer and
//   #     Disable fall back to plaintext (pg_stat_ssl -> f):
//   ./target/live.exe 127.0.0.1 <plain-port> require target/pg-ca.crt
//   ./target/live.exe 127.0.0.1 <plain-port> prefer  target/pg-ca.crt
//   ./target/live.exe 127.0.0.1 <plain-port> disable
//
//   docker stop nova-pg-d8c-tls nova-pg-d8c-plain
//
// Where the TLS machinery lives: this compiler breaks the ABI of
// third-party (git) package types on ANY cross-module boundary — a TlsStream
// produced in one module and used in another segfaults or corrupts
// (repro-local/tls_handshake, peer-module variant). The types of nova-tls
// are therefore used ONLY in this entry module: the handshake and the
// encrypted pump below live here, in main, where they are sound (proven
// against the same server). pgnet carries the plaintext adapter, the
// structured ConnError, and the byte-level negotiation (SslAnswer); its
// module banner documents the deviation from the plan's adapter shape.
//
// Every step prints a line; the last line of a successful mode is
// "D8C LIVE OK: <what was proven>".

module main

import std.net.{TcpStream, real_net}
import std.os.{real_os, args}
import std.fs.{real_fs, read, Path}
import std.encoding.base64.{Base64}
import tls.{TlsStream, ClientConfig, VerificationMode, TlsError, TlsVersion, Tls12, Tls13}
import postgres.{Session, SessionPhase, PgEvent, ParamValue, Row, QueryError, Ready, ClientMessage, SslAnswer, TlsSupported, TlsRefused, PostgresError, Protocol, Malformed}
import postgres.pgnet.{ConnError, connect, open_tcp, connect_plain, text_at, Connection}

/// Whether and how to ask for TLS — slice Д8в criterion 2's TlsMode. It
/// lives in the entry module (see the banner): pgnet imports no tls types.
export type TlsMode enum
    | Disable
    | Prefer(VerificationMode)
    | Require(VerificationMode)

fn main() {
    with Os = real_os() {
        ro argv = args()
        ro host = argv.get(1) ?? "127.0.0.1"
        ro port = (argv.get(2) ?? "").to_int() ?? 5432
        ro mode = argv.get(3) ?? "ca"
        with Fs = real_fs(), Net = real_net() {
            match run(host, port, mode, argv) {
                Ok(detail) => println("D8C LIVE OK: ${detail}")
                Err(reason) => println("D8C LIVE FAIL: ${reason}")
            }
        }
    }
}

fn run(host str, port int, mode str, argv []str) Fs Net Random -> Result[str, str] {
    if mode == "ca" {
        ro ca = read_ca(argv)?
        ro name = argv.get(5) ?? host
        return tls_full_run(host, port, VerificationMode.CustomRoots(ca), name, TlsMode.Require(VerificationMode.CustomRoots(ca)))
    }
    if mode == "mismatch" {
        // (b) TCP to 127.0.0.1, the certificate checked as db.example —
        // the certificate carries localhost/127.0.0.1, so this must be a
        // structured TLS error.
        ro ca = read_ca(argv)?
        return expect_tls_name_error(host, port, VerificationMode.CustomRoots(ca), "db.example")
    }
    if mode == "system" {
        // (c) the system roots do not know our CA — structured TLS error.
        ro name = argv.get(5) ?? host
        return expect_tls_ca_error(host, port, VerificationMode.SystemRoots, name)
    }
    if mode == "multi" {
        return multi_query_iteration(host, port).map_err(fn(e ConnError) -> str { "${e}" })
    }
    if mode == "rowerr" {
        return row_stream_error_recovery(host, port)
    }
    if mode == "require" {
        return expect_refused(host, port)
    }
    if mode == "prefer" {
        ro ca = read_ca(argv)?
        return plaintext_fallback(host, port, VerificationMode.CustomRoots(ca), "Prefer")
    }
    if mode == "disable" {
        return plaintext_disable(host, port)
    }
    Err("unknown mode '${mode}'")
}

fn read_ca(argv []str) Fs -> Result[[]u8, str] {
    ro path = argv.get(4) ?? "target/pg-ca.crt"
    match read(Path.posix(path)) {
        Ok(b) => Ok(b)
        Err(e) => Err("read CA ${path}: ${e}")
    }
}

// ─── TLS in this module (sound here; see the banner) ───────────────────────

// (No record wraps the TlsStream: a tls value read or written through a
// record field is broken in this compiler — protocol_version() returns
// None and writes fail with "Bad input parameters" — while the same calls
// on the bare binding work. Same family as repro-local/enum_consume_socket.
// The pump and the helpers therefore take the stream and the Session as
// two separate mut parameters; nothing wraps the stream.)

fn pump_tls(mut stream TlsStream, mut session Session) Net -> Result[[]PgEvent, str] {
    mut events []PgEvent = []PgEvent.new()
    while true {
        ro out = session.drain()
        if out.len() > 0 {
            match stream.write_all(out) {
                Ok(()) => ()
                Err(e) => return Err("write: ${e}")
            }
        }
        ro chunk = match stream.read_bytes(65536) {
            Ok(b) => b
            Err(e) => return Err("read: ${e}")
        }
        if chunk.len() == 0 {
            return Err("read: server closed the connection")
        }
        ro evs = match session.feed(chunk) {
            Ok(e) => e
            Err(e) => return Err("protocol: ${e}")
        }
        mut i = 0
        while i < evs.len() {
            match evs[i] {
                Ready { .. } => {
                    return Ok(events)
                }
                _ => {
                    events.push(evs[i])
                    i += 1
                }
            }
        }
    }
    Ok(events)
}

// Handshake over the socket the server answered 'S' on, then the start-up
// phase; startup errors carry the structured shape (Auth / Server /
// Protocol) exactly like pgnet's.
// The TLS handshake over the socket the server answered 'S' on. The
// version is read off the bare stream (through a record field the same
// call returns None). Returns the negotiated stream only — the Session is
// the caller's own binding.
fn tls_handshake(consume stream TcpStream, server_name str, verify VerificationMode, mut tls_name str) Net -> Result[TlsStream, str] {
    ro cfg = ClientConfig.new(server_name).verification(verify)
    // The handshake takes an rc-shared handle; our copy closes below (the
    // TlsStream owns the share — the socket outlives our handle).
    consume ts = match TlsStream.connect(stream.share(), cfg) {
        Ok(consume t) => t
        Err(e) => {
            stream.close()
            return Err("tls: ${e}")
        }
    }
    stream.close()
    tls_name = match ts.protocol_version() {
        Some(Tls12) => "TLS 1.2"
        Some(Tls13) => "TLS 1.3"
        None => "unknown TLS version"
    }
    println("live: connected over ${tls_name} (authentication passed)")
    Ok(ts)
}


// (a)+(5): everything over TLS with the custom CA.
fn tls_full_run(host str, port int, verify VerificationMode, server_name str, mode TlsMode) Net Random -> Result[str, str] {
    consume stream = match open_tcp(host, port) {
        Ok(consume s) => s
        Err(e) => return Err("tcp: ${e}")
    }
    // SSLRequest inline: a mut-parameter roundtrip through a sub-function
    // corrupts the socket for the TLS handshake in this compiler
    // (repro-local/plain_consumer history); the request, the answer read
    // and the handshake must stay in one function.
    match stream.write_all(ClientMessage.ssl_request()) {
        Ok(()) => ()
        Err(e) => return Err("sslreq write: ${e}")
    }
    ro answer = match stream.read_bytes(1) {
        Ok(b) => b
        Err(e) => return Err("sslreq read: ${e}")
    }
    if answer.len() == 0 {
        return Err("server closed the connection without answering SSLRequest")
    }
    ro answer = match SslAnswer.classify(answer[0]) {
        Ok(a) => a
        Err(e) => return Err("ssl negotiation: ${e}")
    }
    if answer != TlsSupported {
        // TlsMode.Require on 'N': the structured shape of the refusal.
        match mode {
            Require(_) => return Err("structured error: ConnError.RefusedTls (server answered 'N')")
            _ => return Err("server unexpectedly refused TLS")
        }
    }
    mut tls_name = ""
    consume ts = tls_handshake(stream, server_name, verify, tls_name)?
    consume session = Session.new("postgres", "smoke", "postgres", Base64.encode(Random.bytes(18)))
    // Start-up phase over TLS: the StartupMessage goes out on the first
    // pump; a QueryError here means the server refused the start-up.
    ro evs0 = match pump_tls(ts, session) {
        Ok(e) => e
        Err(e) => return Err(e)
    }
    mut si = 0
    while si < evs0.len() {
        match evs0[si] {
            QueryError { sqlstate, message } => return Err("server error ${sqlstate}: ${message}")
            _ => ()
        }
        si += 1
    }
    if session.phase() != SessionPhase.Ready {
        return Err("start-up did not reach ReadyForQuery")
    }
    ro ssl = single_text_value(ts, session, "SELECT ssl FROM pg_stat_ssl WHERE pid = pg_backend_pid()", "ssl check")?
    if ssl != "t" {
        return Err("pg_stat_ssl.ssl expected 't', got '${ssl}'")
    }
    println("live: pg_stat_ssl -> t")

    // The whole D8b live flow, over TLS.
    ro one = single_text_value(ts, session, "SELECT 1", "select 1")?
    if one != "1" {
        return Err("SELECT 1 expected '1', got '${one}'")
    }
    println("live: SELECT 1 -> '${one}'")
    ro rows = count_rows(ts, session, "SELECT generate_series(1, 10000)")?
    if rows != 10000 {
        return Err("expected 10000 rows, got ${rows}")
    }
    println("live: generate_series -> ${rows} rows")
    ro sqlstate = syntax_error_state(ts, session)?
    if sqlstate != "42601" {
        return Err("expected SQLSTATE 42601, got '${sqlstate}'")
    }
    println("live: syntax error surfaced as SQLSTATE ${sqlstate}")
    ro one2 = single_text_value(ts, session, "SELECT 1", "recovery")?
    if one2 != "1" {
        return Err("recovery query expected '1', got '${one2}'")
    }
    println("live: same connection after the error -> '${one2}'")
    ro sum = extended_text(ts, session, "SELECT \$1::int + 1", "41")?
    if sum != "42" {
        return Err("expected '42', got '${sum}'")
    }
    println("live: extended SELECT \$1::int + 1 with '41' -> '${sum}'")
    if !extended_null(ts, session)? {
        return Err("extended NULL parameter did not come back NULL")
    }
    println("live: extended query with NULL parameter -> NULL")

    // The transaction-status ladder, including the status E carried over
    // from D8b (checked live here for the first time).
    match session.query("BEGIN") {
        Ok(()) => ()
        Err(e) => return Err("${e}")
    }
    ro _b = pump_tls(ts, session)?
    if session.transaction_status() != 'T' as u8 {
        return Err("expected status 'T' after BEGIN")
    }
    println("live: BEGIN -> transaction status 'T'")
    match session.query("SELECT bogus FROM") {
        Ok(()) => ()
        Err(e) => return Err("${e}")
    }
    ro _e = pump_tls(ts, session)?
    if session.transaction_status() != 'E' as u8 {
        return Err("expected status 'E' after the error inside the transaction")
    }
    println("live: error inside the transaction -> status 'E'")
    match session.query("ROLLBACK") {
        Ok(()) => ()
        Err(e) => return Err("${e}")
    }
    ro _r = pump_tls(ts, session)?
    if session.transaction_status() != 'I' as u8 {
        return Err("expected status 'I' after ROLLBACK")
    }
    println("live: ROLLBACK -> transaction status 'I'")

    // Terminate over TLS, then close the stream.
    ro fin = session.close()
    match ts.write_all(fin) {
        Ok(()) => ()
        Err(e) => return Err("close: ${e}")
    }
    ts.close()
    Ok("${tls_name}: SCRAM, ssl=t, SELECT 1, 10000 rows, 42601 recovery, extended 42, NULL, BEGIN/T, error/E, ROLLBACK/I")
}

// (b): the certificate does not carry the asked name — a structured TLS
// error, matched by variant and kind, not by message text.
fn expect_tls_name_error(host str, port int, verify VerificationMode, server_name str) Net Random -> Result[str, str] {
    consume stream = match open_tcp(host, port) {
        Ok(consume s) => s
        Err(e) => return Err("tcp: ${e}")
    }
    // SSLRequest inline: a mut-parameter roundtrip through a sub-function
    // corrupts the socket for the TLS handshake in this compiler
    // (repro-local/plain_consumer history); the request, the answer read
    // and the handshake must stay in one function.
    match stream.write_all(ClientMessage.ssl_request()) {
        Ok(()) => ()
        Err(e) => return Err("sslreq write: ${e}")
    }
    ro answer = match stream.read_bytes(1) {
        Ok(b) => b
        Err(e) => return Err("sslreq read: ${e}")
    }
    if answer.len() == 0 {
        return Err("server closed the connection without answering SSLRequest")
    }
    ro answer = match SslAnswer.classify(answer[0]) {
        Ok(a) => a
        Err(e) => return Err("ssl negotiation: ${e}")
    }
    if answer != TlsSupported {
        return Err("server unexpectedly refused TLS")
    }
    ro cfg = ClientConfig.new(server_name).verification(verify)
    match TlsStream.connect(stream, cfg) {
        Ok(consume t) => {
            t.close()
            Err("connect succeeded with a name the certificate does not carry")
        }
        Err(TlsError.HostnameMismatch(_)) => Ok("structured TLS error: HostnameMismatch (name not in the certificate)")
        Err(e) => Err("wrong error kind: ${e}")
    }
}

// (c): system roots do not know the private CA — a structured TLS error.
fn expect_tls_ca_error(host str, port int, verify VerificationMode, server_name str) Net Random -> Result[str, str] {
    consume stream = match open_tcp(host, port) {
        Ok(consume s) => s
        Err(e) => return Err("tcp: ${e}")
    }
    // SSLRequest inline: a mut-parameter roundtrip through a sub-function
    // corrupts the socket for the TLS handshake in this compiler
    // (repro-local/plain_consumer history); the request, the answer read
    // and the handshake must stay in one function.
    match stream.write_all(ClientMessage.ssl_request()) {
        Ok(()) => ()
        Err(e) => return Err("sslreq write: ${e}")
    }
    ro answer = match stream.read_bytes(1) {
        Ok(b) => b
        Err(e) => return Err("sslreq read: ${e}")
    }
    if answer.len() == 0 {
        return Err("server closed the connection without answering SSLRequest")
    }
    ro answer = match SslAnswer.classify(answer[0]) {
        Ok(a) => a
        Err(e) => return Err("ssl negotiation: ${e}")
    }
    if answer != TlsSupported {
        return Err("server unexpectedly refused TLS")
    }
    ro cfg = ClientConfig.new(server_name).verification(verify)
    match TlsStream.connect(stream, cfg) {
        Ok(consume t) => {
            t.close()
            Err("connect succeeded against an unknown CA")
        }
        Err(TlsError.CertificateInvalid(_)) => Ok("structured TLS error: CertificateInvalid (unknown CA)")
        Err(e) => Err("wrong error kind: ${e}")
    }
}

// Two queries in a row with row iteration in between: the first query's
// stream is closed (drained, connection returned), then the connection
// runs the second query and its own stream.
fn multi_query_iteration(host str, port int) Net Random -> Result[str, ConnError] {
    consume conn = connect(host, port, "postgres", "smoke", "postgres")?
    // Query 1: the connection itself is the row cursor.
    conn.query("SELECT generate_series(1, 5)")?
    mut count = 0
    mut sum = 0
    for row in conn {
        sum += to_int(text_at(row, 0)?)?
        count += 1
    }
    match conn.error() {
        Some(e) => return Err(e)
        None => ()
    }
    if count != 5 || sum != 15 {
        return Err(ConnError.Protocol { error: PostgresError { kind: Malformed { what: "query 1: ${count} rows, sum ${sum} (want 5 and 15)" } } })
    }
    println("live: query 1: ${count} rows iterated, sum ${sum}")
    // The same connection runs query 2 — nothing to give back.
    conn.query("SELECT 42")?
    mut answer = 0
    for row in conn {
        answer = to_int(text_at(row, 0)?)?
    }
    match conn.error() {
        Some(e) => return Err(e)
        None => ()
    }
    if answer != 42 {
        return Err(ConnError.Protocol { error: PostgresError { kind: Malformed { what: "query 2: ${answer} (want 42)" } } })
    }
    println("live: query 2 on the same connection -> '${answer}'")
    conn.close()?
    Ok("multi: 5 rows iterated (sum 15), then SELECT 42 = ${answer} on the same connection")
}

// A server error (SQLSTATE) through the row stream leaves the connection
// usable: next() reports 42601 structurally, @close drains to the cycle
// end and returns the connection, and the next query works.


fn row_stream_error_recovery(host str, port int) Net Random -> Result[str, str] {
    consume conn = match connect(host, port, "postgres", "smoke", "postgres") {
        Ok(consume c) => c
        Err(e) => return Err("connect: ${e}")
    }
    match conn.query("SELEC bogus") {
        Ok(()) => ()
        Err(e) => return Err("query: ${e}")
    }
    ro _ = conn.next()
    ro sqlstate = match conn.error() {
        Some(ConnError.Server { sqlstate, .. }) => sqlstate
        Some(e) => return Err("wrong error variant: ${e}")
        None => return Err("a syntax error produced no error")
    }
    println("live: row iteration surfaced SQLSTATE ${sqlstate}")
    // The connection is usable after a server error: skip the rest of the
    // answer and run the next query on the same connection.
    match conn.skip_answer() {
        Ok(()) => ()
        Err(e) => return Err("skip: ${e}")
    }
    match conn.query("SELECT 1") {
        Ok(()) => ()
        Err(e) => return Err("select 1: ${e}")
    }
    ro one = match conn.next() {
        Some(row) => match text_at(row, 0) {
            Ok(s) => s
            Err(e) => return Err("${e}")
        }
        None => return Err("SELECT 1 produced no row")
    }
    println("live: same connection after the server error -> '${one}'")
    match conn.close() {
        Ok(()) => ()
        Err(e) => return Err("close: ${e}")
    }
    Ok("row iteration: server error 42601 surfaced structurally, connection recovered")
}

// The first row's first value as text, via the for-in API; the stream
// is closed (drained) and the connection returned by the caller.
fn to_int(s str) -> Result[int, ConnError] {
    match s.to_int() {
        Ok(n) => Ok(n)
        Err(_) => Err(ConnError.Protocol { error: PostgresError { kind: Malformed { what: "not an integer: '${s}'" } } })
    }
}


fn plain_text_value2(mut conn Connection, sql str) Net -> Result[str, str] {
    ro evs = match conn.simple_query(sql) {
        Ok(e) => e
        Err(e) => return Err("${e}")
    }
    first_text_value(evs, "select 1")
}

// (d, Require): the plain server refuses TLS — the structured refusal.

// (d, Prefer): 'N' -> plaintext fallback through pgnet, pg_stat_ssl -> f.

// (d, Disable): no SSLRequest on the wire at all, plaintext via pgnet.

// Two queries in a row with row iteration in between: the first query's
// stream is closed (drained, connection returned), then the connection
// runs the second query and its own stream.

// A server error (SQLSTATE) through the row stream leaves the connection
// usable: next() reports 42601 structurally, @close drains to the cycle
// end and returns the connection, and the next query works.


// (d, Require): the plain server refuses TLS — the structured refusal.
fn expect_refused(host str, port int) Net Random -> Result[str, str] {
    consume stream = match open_tcp(host, port) {
        Ok(consume s) => s
        Err(e) => return Err("tcp: ${e}")
    }
    match stream.write_all(ClientMessage.ssl_request()) {
        Ok(()) => ()
        Err(e) => return Err("sslreq write: ${e}")
    }
    ro answer = match stream.read_bytes(1) {
        Ok(b) => b
        Err(e) => return Err("sslreq read: ${e}")
    }
    if answer.len() == 0 {
        return Err("server closed the connection without answering SSLRequest")
    }
    ro answer = match SslAnswer.classify(answer[0]) {
        Ok(a) => a
        Err(e) => return Err("ssl negotiation: ${e}")
    }
    if answer != TlsRefused {
        return Err("plain server unexpectedly offered TLS")
    }
    // The socket is not needed anymore; close it politely.
    stream.close()
    // TlsMode.Require semantics, applied by the consumer of the step API:
    // the 'N' answer becomes the structured variant, matched here — the
    // message text is not the carrier of meaning.
    ro ce = ConnError.RefusedTls
    match ce {
        ConnError.RefusedTls => Ok("structured error: RefusedTls (server answered 'N')")
        _ => Err("unreachable: variant changed under the match")
    }
}

// (d, Prefer): 'N' -> plaintext fallback through pgnet, pg_stat_ssl -> f.
fn plaintext_fallback(host str, port int, verify VerificationMode, what str) Net Random -> Result[str, str] {
    consume stream = match open_tcp(host, port) {
        Ok(consume s) => s
        Err(e) => return Err("tcp: ${e}")
    }
    match stream.write_all(ClientMessage.ssl_request()) {
        Ok(()) => ()
        Err(e) => return Err("sslreq write: ${e}")
    }
    ro answer = match stream.read_bytes(1) {
        Ok(b) => b
        Err(e) => return Err("sslreq read: ${e}")
    }
    if answer.len() == 0 {
        return Err("server closed the connection without answering SSLRequest")
    }
    ro answer = match SslAnswer.classify(answer[0]) {
        Ok(a) => a
        Err(e) => return Err("ssl negotiation: ${e}")
    }
    if answer != TlsRefused {
        return Err("plain server unexpectedly offered TLS")
    }
    consume conn = match connect_plain(stream, "postgres", "smoke", "postgres") {
        Ok(consume c) => c
        Err(e) => return Err("connect: ${e}")
    }
    ro ssl = plain_ssl_value(conn)?
    println("live: ${what} -> plaintext (pg_stat_ssl -> f)")
    Ok("${what} fell back to plaintext, pg_stat_ssl -> f")
}

// (d, Disable): no SSLRequest on the wire at all, plaintext via pgnet.
fn plaintext_disable(host str, port int) Net Random -> Result[str, str] {
    consume conn = match connect_plain(match open_tcp(host, port) {
        Ok(consume s) => s
        Err(e) => return Err("tcp: ${e}")
    }, "postgres", "smoke", "postgres") {
        Ok(consume c) => c
        Err(e) => return Err("connect: ${e}")
    }
    ro ssl = plain_ssl_value(conn)?
    println("live: Disable -> plaintext, no SSLRequest (pg_stat_ssl -> f)")
    Ok("Disable stayed in plaintext, pg_stat_ssl -> f")
}

// ─── small helpers over the query results ──────────────────────────────────

fn single_text_value(mut stream TlsStream, mut session Session, sql str, what str) Net -> Result[str, str] {
    match session.query(sql) {
        Ok(()) => ()
        Err(e) => return Err("${e}")
    }
    ro evs = pump_tls(stream, session)?
    first_text_value(evs, what)
}

// The ssl value pulled through the row-stream API: one row, one next().
fn plain_ssl_value(consume conn Connection) Net -> Result[str, str] {
    match conn.query("SELECT ssl FROM pg_stat_ssl WHERE pid = pg_backend_pid()") {
        Ok(()) => ()
        Err(e) => return Err("${e}")
    }
    mut val = ""
    mut got = false
    for row in conn {
        if !got {
            match text_at(row, 0) {
                Ok(t) => {
                    val = t
                    got = true
                }
                Err(e) => return Err("${e}")
            }
        }
    }
    if !got {
        return Err("no row in the answer")
    }
    match conn.error() {
        Some(e) => return Err("${e}")
        None => ()
    }
    match conn.skip_answer() {
        Ok(()) => ()
        Err(e) => return Err("${e}")
    }
    match conn.close() {
        Ok(()) => ()
        Err(e) => return Err("close: ${e}")
    }
    if val != "f" {
        return Err("pg_stat_ssl.ssl expected 'f', got '${val}'")
    }
    Ok(val)
}

fn first_text_value(evs []PgEvent, what str) -> Result[str, str] {
    mut i = 0
    while i < evs.len() {
        match evs[i] {
            Row { values } => {
                if values.len() < 1 {
                    return Err("${what}: DataRow has no columns")
                }
                ro v = values[0]
                match v.data {
                    Some(b) => {
                        ro s = match b.to_str() {
                            Ok(t) => t
                            Err(_) => return Err("${what}: value is not UTF-8")
                        }
                        return Ok(s)
                    }
                    None => return Err("${what}: unexpected NULL")
                }
            }
            _ => ()
        }
        i += 1
    }
    Err("${what}: no DataRow in events")
}

fn count_rows(mut stream TlsStream, mut session Session, sql str) Net -> Result[int, str] {
    match session.query(sql) {
        Ok(()) => ()
        Err(e) => return Err("${e}")
    }
    ro evs = pump_tls(stream, session)?
    mut rows = 0
    mut i = 0
    while i < evs.len() {
        match evs[i] {
            Row { .. } => { rows += 1 }
            _ => ()
        }
        i += 1
    }
    Ok(rows)
}

fn find_sqlstate(evs []PgEvent) -> str {
    mut i = 0
    while i < evs.len() {
        match evs[i] {
            QueryError { sqlstate, .. } => return sqlstate
            _ => ()
        }
        i += 1
    }
    ""
}

fn syntax_error_state(mut stream TlsStream, mut session Session) Net -> Result[str, str] {
    match session.query("SELEC bogus") {
        Ok(()) => ()
        Err(e) => return Err("${e}")
    }
    ro evs = pump_tls(stream, session)?
    Ok(find_sqlstate(evs))
}

fn extended_text(mut stream TlsStream, mut session Session, sql str, param str) Net -> Result[str, str] {
    mut ps []ParamValue = []ParamValue.new()
    ps.push(ParamValue.text(param))
    match session.query_extended(sql, [], ps, []) {
        Ok(()) => ()
        Err(e) => return Err("${e}")
    }
    ro evs = pump_tls(stream, session)?
    first_text_value(evs, "extended")
}

fn extended_null(mut stream TlsStream, mut session Session) Net -> Result[bool, str] {
    mut ps []ParamValue = []ParamValue.new()
    ps.push(ParamValue.null())
    match session.query_extended("SELECT \$1::int", [], ps, []) {
        Ok(()) => ()
        Err(e) => return Err("${e}")
    }
    ro evs = pump_tls(stream, session)?
    mut i = 0
    while i < evs.len() {
        match evs[i] {
            Row { values } => {
                if values.len() > 0 {
                    ro v = values[0]
                    match v.data {
                        None => return Ok(true)
                        Some(_) => ()
                    }
                }
            }
            _ => ()
        }
        i += 1
    }
    Ok(false)
}

fn tls_version_name(v TlsVersion) -> str =>
    match v {
        Tls12 => "TLS 1.2"
        Tls13 => "TLS 1.3"
    }
